@dataclass
class SessionSettings:
    subject_id: str = DEFAULT_SUBJECT_ID
    language: str = "fr"
    screen_diagonal_in: float = RECOMMENDED_DIAGONAL_IN
    screen_width_cm: float = SCREEN_WIDTH_CM_DEFAULT
    viewing_distance_cm: float = VIEWING_DISTANCE_CM_DEFAULT
    screen_index: int = 0
    axis_mode: str = "vertical"        # "vertical" -> angle_set 0 (Haut/Bas) ; "horizontal" -> angle_set 1 (Gauche/Droite)
    fixation_h_deg: float = 0.0
    fixation_v_deg: float = 0.0
    stim_h_deg: float = 0.0            # neutre par defaut ; l'ecran de configuration force une saisie consciente
    stim_v_deg: float = 0.0
    n_trials: int = TOTAL_TRIALS_DEFAULT
    show_precue: bool = True
    pause_mode: int = 0                # 0, 1 ou 2 pauses

    # Verification physique de calibration (voir run_calibration_check_screen) :
    # NE PAS demander a chaque seance (demande explicitement le 27/08 -- MATLAB,
    # lui, la redemande a chaque lancement sans exception) -- seulement la
    # premiere fois, ou de nouveau si le PROFIL ECRAN REELLEMENT RESOLU (pas
    # seulement les valeurs saisies) differe de celui pour lequel elle a ete
    # confirmee la derniere fois. calibration_verified n'est vrai que si les 5
    # champs calib_verified_* ci-dessous correspondent EXACTEMENT au profil
    # resolu de la seance courante (voir run_setup_wizard) ; sinon on redemande.
    calibration_verified: bool = False
    calib_verified_width_px: int = 0
    calib_verified_height_px: int = 0
    calib_verified_diagonal_in: float = 0.0
    calib_verified_width_cm: float = 0.0
    calib_verified_distance_cm: float = 0.0

    @property
    def angle_set(self) -> int:
        return 0 if self.axis_mode == "vertical" else 1

    def to_dict(self) -> dict:
        return asdict(self)

    @classmethod
    def from_dict(cls, d: dict) -> "SessionSettings":
        known = {f.name for f in fields(cls)}
        filtered = {k: v for k, v in d.items() if k in known}
        return cls(**filtered)


def _load_json(path: str) -> dict:
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except (json.JSONDecodeError, OSError):
        return {}


def _save_json(path: str, data: dict, logger: Optional[logging.Logger] = None) -> bool:
    """Ecrit un JSON de facon atomique (fichier temporaire + os.replace).
    CORRIGE PAR RAPPORT AU PYTHON PRECEDENT (27/08, round 3) : auparavant,
    aucune exception n'etait interceptee ici -- une erreur disque (droits
    refuses, disque plein, chemin invalide) faisait planter l'appelant sans
    aucune gestion. Contrairement a write_session_outputs (code E12, resultats
    de seance patient, qui bascule vers un repertoire de secours), les 4
    appelants de cette fonction n'ecrivent QUE des preferences/reglages --
    jamais de donnees de seance. Un echec est donc seulement journalise (si un
    logger est disponible ; certains appelants tournent avant toute
    initialisation de logger, voir _ask_language_if_unknown) et n'interrompt
    jamais l'appelant : le pire cas est un reglage non memorise pour la
    prochaine fois, deja tolere silencieusement ailleurs (voir
    load_last_settings, qui repart des valeurs par defaut si le fichier est
    absent/corrompu). Retourne True si l'ecriture a reussi, False sinon."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp_path = path + ".tmp"
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False, sort_keys=True)
        os.replace(tmp_path, path)
        return True
    except OSError as exc:
        if logger is not None:
            logger.warning("Echec d'ecriture de %s (reglage non memorise pour la prochaine fois) : %s", path, exc)
        return False


def load_last_settings(subject_id: str) -> Optional[SessionSettings]:
    """Recharge les derniers reglages connus pour ce patient, ou None si premiere
    utilisation / fichier corrompu (auquel cas on repart silencieusement des
    valeurs par defaut plutot que de bloquer la seance)."""
    store = _load_json(SETTINGS_FILE)
    entry = store.get(subject_id)
    if entry is None:
        return None
    try:
        return SessionSettings.from_dict(entry)
    except (TypeError, ValueError):
        return None


def save_settings(settings: SessionSettings, logger: Optional[logging.Logger] = None) -> None:
    store = _load_json(SETTINGS_FILE)
    store[settings.subject_id] = settings.to_dict()
    _save_json(SETTINGS_FILE, store, logger)


