def main() -> Optional[SessionOutcome]:
    try:
        run_startup_self_tests()
    except Exception as exc:
        # AJOUT PAR RAPPORT AU PYTHON PRECEDENT (27/08, code E99) : ce popup
        # utilisait auparavant un texte bilingue code en dur, hors du systeme
        # TR/t() -- normal, puisqu'il se declenche AVANT tout appel a
        # _ask_language_if_unknown() dans le flux de controle. On recupere ici
        # la langue eventuellement deja memorisee (load_app_language) pour
        # afficher un message correctement localise ; a defaut, on retombe sur
        # le francais (public principal de l'outil) plutot que sur un texte
        # bilingue approximatif.
        try:
            fallback_lang = load_app_language() or "fr"
        except Exception:
            fallback_lang = "fr"
        try:
            err = gui.Dlg(title=f'{t("err_startup_selftest_title", fallback_lang)} [{ERR_CODE_STARTUP_SELFTEST}]')
            err.addText(t("err_startup_selftest_msg", fallback_lang, detail=exc))
            err.show()
        except Exception:
            print("ERREUR CRITIQUE (auto-test de demarrage) :", exc, file=sys.stderr)
            traceback.print_exc()
        return None

    bootstrap_logger = logging.getLogger(SOFTWARE_NAME)
    wizard = run_setup_wizard(bootstrap_logger)
    if wizard is None:
        return None
    settings, profile = wizard

    timestamp = _dt.datetime.now()
    session_num = next_session_number(settings.subject_id, bootstrap_logger)
    logger = setup_logging(settings.subject_id, session_num, timestamp)
    logger.info("Auto-tests de demarrage : OK.")
    logger.info("Reglages retenus : %s", json.dumps(settings.to_dict(), ensure_ascii=False))
    logger.info(
        "Profil ecran : index=%d resolution=%dx%d diagonale=%.1fpo largeur=%.1fcm distance=%.1fcm "
        "px_par_deg=%.2f taille_point=%.1fpx",
        profile.screen_index, profile.width_px, profile.height_px, profile.diagonal_in,
        profile.width_cm, profile.viewing_distance_cm, profile.px_per_deg, profile.dot_size_px,
    )

    lang = settings.language

    # ---------------------------------------------------------------------
    # Ouverture fenetre + verification physique de la calibration (boucle) :
    # reproduit l'ecran test_rect2/test_size/test_size2 de MATLAB (voir
    # run_calibration_check_screen). MATLAB, lui, la MONTRE A CHAQUE SEANCE
    # sans exception, sans le moindre raccourci pour la sauter. CORRECTIF
    # (27/08, round 3) : ce commentaire affirmait auparavant, a tort, le meme
    # comportement pour cette version Python -- il decrivait un etat perime
    # depuis la tache #43 (verification calibration : une seule fois, pas a
    # chaque seance). Le comportement REEL, inchange depuis, est : une seule
    # fois par profil ecran exact (resolution + diagonale/largeur/distance
    # saisies), voir SessionSettings.calibration_verified et le garde-fou
    # `if settings.calibration_verified: ... break` juste plus bas dans cette
    # meme boucle -- et son pendant dans run_setup_wizard (ligne ~2622) qui
    # decide si ce flag est reconduit d'une seance a l'autre. Si l'utilisateur
    # indique que les mesures ne correspondent pas, on ferme la fenetre et on
    # rouvre EXACTEMENT le meme formulaire de calibration que
    # run_setup_wizard (_ask_full_settings) -- jamais un second point de
    # saisie -- puis on reessaie avec le nouveau profil.
    # ---------------------------------------------------------------------
    while True:
        mon = monitors.Monitor(f"fba_tiltglobal_{settings.subject_id}")
        mon.setWidth(profile.width_cm)
        mon.setDistance(profile.viewing_distance_cm)
        mon.setSizePix([profile.width_px, profile.height_px])

        try:
            win = visual.Window(
                size=(profile.width_px, profile.height_px), fullscr=True, screen=profile.screen_index,
                monitor=mon, units="pix", color=BACKGROUND_RGB, colorSpace="rgb", allowGUI=False,
            )
        except Exception as exc:
            # AJOUT PAR RAPPORT AU PYTHON PRECEDENT (27/08, code E98) : cet
            # echec etait auparavant journalise (logger.error) mais sans
            # AUCUN message a l'ecran pour le patient/aidant -- puisqu'aucune
            # fenetre PsychoPy n'existe encore a ce stade, un TextStim est
            # impossible ; on utilise gui.Dlg, comme pour E99.
            logger.error("[%s] Impossible d'ouvrir la fenetre PsychoPy : %s", ERR_CODE_WINDOW_OPEN, exc)
            log_uncaught_exception(logger, exc)
            try:
                err = gui.Dlg(title=f'{t("err_window_title", lang)} [{ERR_CODE_WINDOW_OPEN}]')
                err.addText(t("err_window_msg", lang))
                err.show()
            except Exception:
                print("ERREUR CRITIQUE (ouverture fenetre) :", exc, file=sys.stderr)
            return None

        calib = compute_calibration_check(profile, settings)

        if settings.calibration_verified:
            # Deja verifiee au metre pour ce profil exact (voir run_setup_wizard) --
            # demande explicitement le 27/08 de ne PAS la redemander a chaque seance.
            logger.info("Verification physique de calibration sautee (deja confirmee pour ce profil ecran).")
            break

        calib_result = run_calibration_check_screen(win, profile, settings, calib, lang)

        if calib_result == "confirmed":
            settings.calibration_verified = True
            settings.calib_verified_width_px = profile.width_px
            settings.calib_verified_height_px = profile.height_px
            settings.calib_verified_diagonal_in = profile.diagonal_in
            settings.calib_verified_width_cm = profile.width_cm
            settings.calib_verified_distance_cm = profile.viewing_distance_cm
            save_settings(settings, logger)
            break

        win.close()
        if calib_result == "quit":
            logger.info("Seance annulee par l'utilisateur a l'ecran de verification physique.")
            return None

        logger.info("Calibration jugee incorrecte par l'utilisateur -- retour au formulaire de calibration.")
        edited = _ask_full_settings(lang, settings)
        if edited is None:
            logger.info("Correction de calibration annulee par l'utilisateur.")
            return None
        settings, profile = edited
        save_settings(settings, logger)
        logger.info("Reglages corriges : %s", json.dumps(settings.to_dict(), ensure_ascii=False))
        logger.info(
            "Profil ecran corrige : index=%d resolution=%dx%d diagonale=%.1fpo largeur=%.1fcm "
            "distance=%.1fcm px_par_deg=%.2f taille_point=%.1fpx",
            profile.screen_index, profile.width_px, profile.height_px, profile.diagonal_in,
            profile.width_cm, profile.viewing_distance_cm, profile.px_per_deg, profile.dot_size_px,
        )

    axis_instruction = t("instr_vertical", lang) if settings.axis_mode == "vertical" else t("instr_horizontal", lang)
    _, actual_total = compute_actual_trial_counts(settings.n_trials)
    readme_intro_text = t("readme_body_intro", lang)
    readme_disclaimer_text = t("readme_disclaimer", lang)
    readme_details_text = t(
        "readme_body_details", lang,
        h=settings.stim_h_deg, v=settings.stim_v_deg,
        fix_h=settings.fixation_h_deg, fix_v=settings.fixation_v_deg,
        dist=settings.viewing_distance_cm,
        diag=settings.screen_diagonal_in, ntrials=actual_total,
        precue=(t("yes", lang) if settings.show_precue else t("no", lang)),
        box_cm=calib["box_cm"], box_in=calib["box_in"], line_cm=calib["line_cm"], line_in=calib["line_in"],
        axis_instruction=axis_instruction,
    )
    readme_stims = build_readme_stims(
        win, profile.width_px * 0.7, readme_intro_text, readme_disclaimer_text, readme_details_text,
    )
    for stim in readme_stims:
        stim.draw()
    win.flip()
    keys = event.waitKeys(keyList=["space", "escape"])
    if keys and keys[0] == "escape":
        logger.info("Seance annulee par l'utilisateur a l'ecran d'instructions.")
        win.close()
        return None

    outcome = run_session(win, profile, settings, logger)

    if outcome.perf_check_failed:
        # AJOUT PAR RAPPORT A MATLAB (27/08, code E10) : aucun essai reel n'a
        # ete execute (echec bloquant de la verification initiale de
        # performance) -- rien a enregistrer, on l'affiche directement.
        # Design confirme par l'utilisateur : bloquant, pas de tentative de
        # sauvegarde d'une seance qui n'a jamais reellement commence.
        title = f'{t("err_perf_check_title", lang)} [{ERR_CODE_PERF_CHECK}]'
        body = t("err_perf_check_msg", lang) + "\n\n" + t("end_press_key", lang)
        end_text = visual.TextStim(win, text=title + "\n\n" + body, color=TEXT_COLOR_RGB, height=24,
                                    wrapWidth=profile.width_px * 0.7, units="pix")
        end_text.draw()
        win.flip()
        event.waitKeys()
        win.close()
        logger.info("Fin de seance : verification initiale de performance echouee, seance non demarree.")
        return outcome

    csv_path, json_path, save_status = write_session_outputs(settings, profile, outcome, session_num, timestamp, logger)

    if outcome.error:
        title = t("end_error_title", lang)
        body = t("end_trials", lang, done=outcome.n_completed, total=outcome.total_trials_planned)
    elif outcome.aborted:
        title = t("end_aborted_title", lang)
        body = (
            t("end_trials", lang, done=outcome.n_completed, total=outcome.total_trials_planned) + "\n"
            + t("end_accuracy", lang, acc=outcome.accuracy_percent) + "\n"
            + t("escape_quit_saved", lang)
        )
    else:
        title = t("end_complete_title", lang)
        body = (
            t("end_accuracy", lang, acc=outcome.accuracy_percent) + "\n"
            + t("end_final_level", lang, lvl=outcome.final_threshold_deg) + "\n"
            + t("end_trials", lang, done=outcome.n_completed, total=outcome.total_trials_planned) + "\n\n"
            + t("end_note_fit", lang)
        )

    # AJOUTS PAR RAPPORT A MATLAB (27/08, codes E11/E12) : notes informatives
    # non bloquantes ajoutees a l'ecran de fin de seance, en plus du
    # journal -- le patient/aidant doit pouvoir les constater sans avoir a
    # consulter les logs.
    if save_status == "secours":
        body += "\n\n" + f'{t("err_save_failed_note", lang)} [{ERR_CODE_SAVE_FAILURE}]'
    elif save_status == "echec":
        body += "\n\n" + f'{t("err_save_failed_total_note", lang)} [{ERR_CODE_SAVE_FAILURE}]'
    if outcome.power_source_changed:
        body += "\n\n" + f'{t("warn_power_change_note", lang)} [{ERR_CODE_POWER_SOURCE}]'

    body += "\n\n" + t("end_press_key", lang)

    end_text = visual.TextStim(win, text=title + "\n\n" + body, color=TEXT_COLOR_RGB, height=24,
                                wrapWidth=profile.width_px * 0.7, units="pix")
    end_text.draw()
    win.flip()
    event.waitKeys()
    win.close()

    logger.info(
        "Fin de seance : essais=%d/%d corrects=%d precision=%.1f%% seuil_final=%.2fdeg interrompue=%s erreur=%s",
        outcome.n_completed, outcome.total_trials_planned, outcome.n_correct, outcome.accuracy_percent,
        outcome.final_threshold_deg, outcome.aborted, outcome.error,
    )
    return outcome


if __name__ == "__main__":
    main()
