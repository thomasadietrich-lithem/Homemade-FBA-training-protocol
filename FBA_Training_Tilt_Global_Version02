def load_app_language() -> Optional[str]:
    lang = _load_json(APP_PREFS_FILE).get("language")
    return lang if lang in TR else None


def save_app_language(lang: str) -> None:
    prefs = _load_json(APP_PREFS_FILE)
    prefs["language"] = lang
    _save_json(APP_PREFS_FILE, prefs)


def _load_last_subject_id() -> str:
    sid = _load_json(APP_PREFS_FILE).get("last_subject_id")
    return sid if sid else DEFAULT_SUBJECT_ID


def _save_last_subject_id(subject_id: str, logger: Optional[logging.Logger] = None) -> None:
    prefs = _load_json(APP_PREFS_FILE)
    prefs["last_subject_id"] = subject_id
    _save_json(APP_PREFS_FILE, prefs, logger)


_LANG_DISPLAY_NAMES = {"fr": "Francais", "en": "English"}
_LANG_DISPLAY_TO_CODE = {v: k for k, v in _LANG_DISPLAY_NAMES.items()}


# -----------------------------------------------------------------------------
# Assistant de configuration -- une seule fenetre de saisie par lancement
# -----------------------------------------------------------------------------
# Design (revise suite aux retours d'usage reel) : au lieu d'enchainer 5 ecrans
# a chaque lancement, on distingue deux cas :
#  - Reglages deja memorises pour ce patient -> UNE fenetre courte recapitule
#    ces reglages (texte, non modifiable) avec une case a cocher "Modifier ces
#    reglages avant de commencer" (decochee par defaut). Si elle reste
#    decochee, on relance directement avec ces reglages (apres une revalidation
#    materielle silencieuse). Cela evite de re-poser 13 questions a chaque
#    seance d'un meme patient.
#  - Sinon (premiere fois, ou case cochee) -> UNE fenetre complete regroupant
#    tous les champs (ecran, position, parametres de seance). Toutes les
#    erreurs de saisie ou de garde-fou materiel rouvrent cette MEME fenetre
#    (jamais une cascade d'ecrans differents).
# Tout est construit avec `gui.Dlg` (lecture via `.data`, dans l'ordre exact
# d'ajout des champs -- chaque index est commente ci-dessous pour eviter toute
# erreur de decalage).

def _ask_language_if_unknown() -> Optional[str]:
    lang = load_app_language()
    if lang is not None:
        return lang
    dlg = gui.Dlg(title="Langue / Language")
    dlg.addField("Langue / Language", choices=[_LANG_DISPLAY_NAMES["fr"], _LANG_DISPLAY_NAMES["en"]])  # 0
    dlg.show()
    if not dlg.OK:
        return None
    try:
        choice = str(dlg.data[0])
    except IndexError:
        choice = _LANG_DISPLAY_NAMES["fr"]
    lang = _LANG_DISPLAY_TO_CODE.get(choice, "fr")
    save_app_language(lang)
    return lang


def _describe_screen(s: dict, lang: str) -> str:
    tag = ("principal" if s["is_primary"] else "secondaire") if lang == "fr" else ("primary" if s["is_primary"] else "secondary")
    return f'{s["index"]}: {s["width_px"]}x{s["height_px"]} ({tag})'


MESSAGE_BOX_MAX_WIDTH_PX = 420  # voir _wrap_label


def _wrap_label(label) -> None:
    """addText() renvoie en realite le QLabel Qt sous-jacent (verifie dans le
    code source de PsychoPy : psychopy/gui/qtgui.py, Dlg.addText retourne
    textLabel). Par defaut ce QLabel n'active pas le retour a la ligne, donc un
    message un peu long s'affichait sur une seule ligne tres large, forcant
    toute la fenetre a s'etirer demesurement (signale par l'utilisateur pour
    les popups d'erreur ecran). On force le retour a la ligne et une largeur
    maximale raisonnable. Best-effort : si l'objet renvoye ne supporte pas ces
    methodes Qt (version de PsychoPy differente), on ignore silencieusement --
    c'est un defaut purement cosmetique, pas une raison de faire planter la
    seance."""
    try:
        label.setWordWrap(True)
        label.setMaximumWidth(MESSAGE_BOX_MAX_WIDTH_PX)
    except Exception:
        pass


def _show_info_dialog(title: str, message: str) -> None:
    dlg = gui.Dlg(title=title)
    _wrap_label(dlg.addText(message))
    dlg.show()


def _ask_yes_no(title: str, message: str, lang: str) -> bool:
    """Utilise gui.Dlg (pas DlgFromDict) pour bien separer le bloc de texte,
    potentiellement long et multi-lignes, de la question elle-meme."""
    dlg = gui.Dlg(title=title)
    _wrap_label(dlg.addText(message))
    dlg.addField(">>>", choices=[t("btn_no", lang), t("btn_yes", lang)])  # 0
    dlg.show()
    if not dlg.OK:
        return False
    try:
        return str(dlg.data[0]) == t("btn_yes", lang)
    except IndexError:
        return False


def _blank_settings(subject_id: str, lang: str) -> "SessionSettings":
    return SessionSettings(subject_id=subject_id, language=lang)


def _format_settings_summary(s: "SessionSettings", lang: str) -> str:
    _, total = compute_actual_trial_counts(s.n_trials)
    axis_label = t("axis_vertical", lang) if s.axis_mode == "vertical" else t("axis_horizontal", lang)
    pause_label = t(["pause_0", "pause_1", "pause_2"][s.pause_mode], lang)
    precue_label = t("yes", lang) if s.show_precue else t("no", lang)
    return "\n".join([
        f'{t("field_subject_id", lang)}: {s.subject_id}',
        f'{t("field_screen_choice", lang)}: #{s.screen_index} - {s.screen_diagonal_in:.1f}" / '
        f'{s.screen_width_cm:.1f}cm / {s.viewing_distance_cm:.1f}cm',
        f'{t("field_axis", lang)}: {axis_label}',
        f'{t("field_fix_h", lang)}: {s.fixation_h_deg:.2f}   {t("field_fix_v", lang)}: {s.fixation_v_deg:.2f}',
        f'{t("field_stim_h", lang)}: {s.stim_h_deg:.2f}   {t("field_stim_v", lang)}: {s.stim_v_deg:.2f}',
        f'{t("field_n_trials", lang)}: {total}',
        f'{t("field_precue", lang)}: {precue_label}',
        f'{t("field_pause_mode", lang)}: {pause_label}',
    ])


def _ask_recall_or_edit(lang: str, prev: "SessionSettings") -> Optional[Tuple[str, bool]]:
    """Fenetre courte, affichee uniquement quand des reglages memorises
    existent deja pour le dernier identifiant utilise. Retourne (identifiant
    saisi, veut_modifier), ou None si l'utilisateur annule."""
    dlg = gui.Dlg(title=t("recall_dlg_title", lang))
    dlg.addText(t("recall_intro", lang))
    dlg.addField(t("field_subject_id", lang), prev.subject_id)  # 0
    dlg.addText(_format_settings_summary(prev, lang))
    dlg.addField(t("field_modify", lang), False)  # 1
    dlg.show()
    if not dlg.OK:
        return None
    try:
        subject_id = str(dlg.data[0]).strip() or DEFAULT_SUBJECT_ID
        want_modify = bool(dlg.data[1])
    except IndexError:
        return prev.subject_id, True
    return subject_id, want_modify


def _ask_full_settings(lang: str, base: "SessionSettings",
                        force_measure: bool = False) -> Optional[Tuple["SessionSettings", "ScreenProfile"]]:
    """L'unique fenetre complete de configuration, organisee en sections
    (Consignes / Utilisateur / Ecran / Exercice / Stimulus) pour rester lisible
    malgre le nombre de champs. Toute erreur de saisie ou de garde-fou materiel
    rouvre cette meme fenetre, prefillee avec la derniere saisie, plutot que de
    renvoyer vers un autre ecran.

    AJOUT PAR RAPPORT AU PYTHON PRECEDENT (round 4, 27/08, demande explicitement) :
    les 13 champs sont desormais tous marques obligatoires (astérisque + legende,
    voir req()/field_required_note) et la diagonale/largeur physique de l'ecran ne
    sont plus jamais pre-remplies avec une valeur non mesuree -- ni le placeholder
    "recommande" (RECOMMENDED_DIAGONAL_IN/SCREEN_WIDTH_CM_DEFAULT), ni l'ancienne
    estimation automatique a partir de la diagonale seule (voir
    estimate_width_cm_from_diagonal, desormais un simple filet de securite pour
    d'anciens reglages sauvegardes, plus une fonctionnalite offerte au patient).
    force_measure=True (uniquement pour un patient sans aucun historique reel,
    voir _ask_full_settings_confirmed) blanchit ces deux champs au tout premier
    affichage seulement -- un nouvel essai apres une erreur sur CETTE soumission
    re-prefille avec ce que le patient vient de taper, jamais une seconde fois a
    vide. Un patient avec un historique reel (force_measure=False) voit toujours sa
    derniere mesure reelle, comme avant."""

    def req(label: str) -> str:
        return f"{label} *"

    first_pass = True
    while True:
        screens = detect_screens()
        screen_labels = [_describe_screen(s, lang) for s in screens]
        default_screen_idx = min(max(base.screen_index, 0), len(screen_labels) - 1)
        ordered_screens = [screen_labels[default_screen_idx]] + [l for l in screen_labels if l != screen_labels[default_screen_idx]]

        axis_key = "axis_vertical" if base.axis_mode == "vertical" else "axis_horizontal"
        other_axis_key = "axis_horizontal" if base.axis_mode == "vertical" else "axis_vertical"
        ordered_axis = [t(axis_key, lang), t(other_axis_key, lang)]

        pause_keys = ["pause_0", "pause_1", "pause_2"]
        ordered_pause = [t(pause_keys[base.pause_mode], lang)] + [t(k, lang) for k in pause_keys if k != pause_keys[base.pause_mode]]

        # Ne blanchir qu'au tout premier affichage ET seulement si ce patient n'a
        # aucune mesure reelle connue -- voir docstring ci-dessus.
        blank_measurements = force_measure and first_pass
        diagonal_default = "" if blank_measurements else base.screen_diagonal_in
        width_default = "" if blank_measurements else base.screen_width_cm

        dlg = gui.Dlg(title=t("setup_dlg_title", lang))

        dlg.addText(t("section_consignes", lang))
        dlg.addText(t("consignes_text", lang))
        dlg.addText(t("field_required_note", lang))

        dlg.addText(t("section_user", lang))
        dlg.addField(req(t("field_subject_id", lang)), base.subject_id)                # 0

        dlg.addText(t("section_screen", lang))
        dlg.addField(req(t("field_screen_choice", lang)), choices=ordered_screens)     # 1
        dlg.addField(req(t("field_diagonal_in", lang)), diagonal_default)              # 2
        dlg.addField(req(t("field_width_cm", lang)), width_default)                    # 3
        dlg.addField(req(t("field_distance_cm", lang)), base.viewing_distance_cm)      # 4

        dlg.addText(t("section_exercise", lang))
        dlg.addField(req(t("field_fix_h", lang)), base.fixation_h_deg)                 # 5
        dlg.addField(req(t("field_fix_v", lang)), base.fixation_v_deg)                 # 6
        dlg.addField(req(t("field_n_trials", lang)), base.n_trials)                    # 7
        dlg.addField(req(t("field_pause_mode", lang)), choices=ordered_pause)          # 8

        dlg.addText(t("section_stimulus", lang))
        dlg.addField(req(t("field_stim_h", lang)), base.stim_h_deg)                    # 9
        dlg.addField(req(t("field_stim_v", lang)), base.stim_v_deg)                    # 10
        dlg.addField(req(t("field_axis", lang)), choices=ordered_axis)                 # 11
        dlg.addField(req(t("field_precue", lang)), base.show_precue)                   # 12
        dlg.show()
        first_pass = False
        if not dlg.OK:
            return None

        try:
            d = dlg.data
            subject_id = str(d[0]).strip()
            screen_index = int(str(d[1]).split(":")[0].strip())
            diagonal_in = float(d[2])
            width_cm = float(d[3])
            distance_cm = float(d[4])
            fix_h, fix_v = float(d[5]), float(d[6])
            n_trials = max(N_STAIRCASES, int(d[7]))
            pause_mode = {t("pause_0", lang): 0, t("pause_1", lang): 1, t("pause_2", lang): 2}.get(str(d[8]), 0)
            stim_h, stim_v = float(d[9]), float(d[10])
            axis_mode = "vertical" if str(d[11]) == t("axis_vertical", lang) else "horizontal"
            show_precue = bool(d[12])
            # CORRECTIF (round 4, 27/08) : subject_id retombait silencieusement sur
            # DEFAULT_SUBJECT_ID s'il etait laisse vide -- incoherent avec "tous les
            # champs sont obligatoires". width_cm<=0 est desormais rejete ici aussi
            # (auparavant seul un ValueError de float() sur un champ vide l'aurait
            # attrape ; une valeur explicitement saisie a 0 ou negative passait).
            if not subject_id or diagonal_in <= 0 or width_cm <= 0 or distance_cm <= 0:
                raise ValueError("valeurs obligatoires manquantes ou invalides")
        except (ValueError, IndexError):
            _show_info_dialog(f'{t("err_generic_title", lang)} [{ERR_CODE_INVALID_INPUT}]', t("err_invalid_inputs", lang))
            continue

        candidate = SessionSettings(
            subject_id=subject_id, language=lang, screen_index=screen_index,
            screen_diagonal_in=diagonal_in, screen_width_cm=width_cm, viewing_distance_cm=distance_cm,
            axis_mode=axis_mode, fixation_h_deg=fix_h, fixation_v_deg=fix_v,
            stim_h_deg=stim_h, stim_v_deg=stim_v, n_trials=n_trials,
            show_precue=show_precue, pause_mode=pause_mode,
        )
        base = candidate  # pour reprefiller la fenetre si une des verifications suivantes echoue

        chosen = next((s for s in screens if s["index"] == screen_index), screens[0])
        if not validate_resolution(chosen["width_px"], chosen["height_px"]):
            _show_info_dialog(f'{t("err_resolution_title", lang)} [{ERR_CODE_RESOLUTION}]', t("err_resolution_msg", lang,
                res=f'{chosen["width_px"]}x{chosen["height_px"]}', minres=f"{MIN_RESOLUTION_PX[0]}x{MIN_RESOLUTION_PX[1]}"))
            continue

        diag_class = classify_diagonal(diagonal_in)
        if diag_class == "reject":
            _show_info_dialog(f'{t("err_diagonal_title", lang)} [{ERR_CODE_DIAGONAL_MIN}]', t("err_diagonal_msg", lang,
                diag=diagonal_in, mindiag=MIN_DIAGONAL_IN, recdiag=RECOMMENDED_DIAGONAL_IN))
            continue
        if diag_class == "warn":
            if not _ask_yes_no(f'{t("warn_diagonal_title", lang)} [{ERR_CODE_DIAGONAL_WARN}]', t("warn_diagonal_msg", lang,
                    diag=diagonal_in, mindiag=MIN_DIAGONAL_IN, recdiag=RECOMMENDED_DIAGONAL_IN), lang):
                continue

        # Garde-fou anti-triche (1/2) : heuristique souple de plausibilite DPI.
        # Avertit (n'empeche pas) sur une combinaison resolution/diagonale typique
        # d'une dalle d'ordinateur portable declaree avec une diagonale exageree.
        dpi = estimate_dpi(chosen["width_px"], chosen["height_px"], diagonal_in)
        if not is_dpi_plausible(dpi):
            if not _ask_yes_no(f'{t("warn_dpi_title", lang)} [{ERR_CODE_DPI}]', t("warn_dpi_msg", lang,
                    diag=diagonal_in, res=f'{chosen["width_px"]}x{chosen["height_px"]}', dpi=dpi), lang):
                continue

        # Garde-fou anti-triche (2/2) : detection technique reelle (Windows
        # uniquement pour l'instant -- voir detect_windows_internal_display).
        # Avertit UNIQUEMENT (jamais de blocage dur) : ce code n'a pas pu etre
        # teste sur une vraie machine Windows pendant le developpement, donc en
        # cas d'erreur de detection la consequence doit rester reversible.
        internal_detected = detect_windows_internal_display()
        if internal_detected is True:
            if not _ask_yes_no(f'{t("warn_internal_display_title", lang)} [{ERR_CODE_INTERNAL_DISPLAY}]',
                                t("warn_internal_display_msg", lang), lang):
                continue

        profile = build_screen_profile(screen_index, chosen["width_px"], chosen["height_px"], diagonal_in, width_cm, distance_cm)
        if profile.dot_size_px < MIN_DOT_SIZE_PX:
            _show_info_dialog(f'{t("err_dotsize_title", lang)} [{ERR_CODE_DOT_SIZE}]', t("err_dotsize_msg", lang,
                px=f"{profile.dot_size_px:.1f}", minpx=MIN_DOT_SIZE_PX))
            continue

        fit = check_stimulus_fits(profile.px_per_deg, profile.width_px, profile.height_px, stim_h, stim_v)
        if not fit["ok"]:
            fov = 2.0 * min(fit["half_w_deg"], fit["half_h_deg"])
            ecc = max(fit["needed_h_deg"], fit["needed_v_deg"])
            _show_info_dialog(f'{t("err_fit_title", lang)} [{ERR_CODE_STIM_FIT}]',
                               t("err_fit_msg", lang, ecc=ecc, ap=APERTURE_RADIUS_DEG, fov=fov))
            continue

        return candidate, profile


def _confirm_settings_change(lang: str, diffs: List[Tuple[str, str, str]]) -> bool:
    """Popup affichee uniquement quand les reglages valides different de la
    derniere seance memorisee pour cet utilisateur (voir diff_settings).
    Repondre 'Non' renvoie vers la fenetre de configuration, prefillee, pour
    corriger avant de relancer."""
    lines = "\n".join(
        f'- {t(_FIELD_LABEL_KEY.get(key, key), lang)} : {old} -> {new}'
        for key, old, new in diffs
    )
    message = "\n\n".join([t("confirm_changed_diff", lang), lines, t("confirm_proceed", lang)])
    return _ask_yes_no(t("confirm_changed_title", lang), message, lang)


def _ask_full_settings_confirmed(lang: str, base: "SessionSettings",
                                  prev: Optional["SessionSettings"]) -> Optional[Tuple["SessionSettings", "ScreenProfile"]]:
    """Enchaine _ask_full_settings et, uniquement si les reglages valides
    different de la derniere seance memorisee, la popup de confirmation --
    en reprefillant et rouvrant la meme fenetre tant que l'ecart n'est ni
    confirme, ni corrige.

    AJOUT (round 4, 27/08) : force_measure=True uniquement quand prev est None,
    c'est-a-dire un patient sans AUCUN historique reel -- voir _ask_full_settings.
    Sans consequence sur la boucle ci-dessous : si prev est None, diff_settings
    renvoie toujours [] (rien a comparer), donc cette boucle ne fait jamais plus
    d'un tour dans ce cas precis ; force_measure ne peut donc jamais blanchir les
    champs une seconde fois."""
    force_measure = prev is None
    while True:
        edited = _ask_full_settings(lang, base, force_measure)
        if edited is None:
            return None
        base, profile = edited
        diffs = diff_settings(prev, base)
        if not diffs or _confirm_settings_change(lang, diffs):
            return base, profile


def run_setup_wizard(logger: logging.Logger) -> Optional[Tuple["SessionSettings", "ScreenProfile"]]:
    lang = _ask_language_if_unknown()
    if lang is None:
        return None

    last_id = _load_last_subject_id()
    prev = load_last_settings(last_id)

    if prev is not None:
        recall = _ask_recall_or_edit(lang, prev)
        if recall is None:
            return None
        subject_id, want_modify = recall
        if subject_id != prev.subject_id:
            # Identifiant different de celui affiche dans le recapitulatif : on
            # considere qu'il s'agit d'un autre utilisateur. On reassigne `prev`
            # a SES reglages memorises s'ils existent (sinon None), pour que la
            # comparaison d'ecarts/popup de confirmation plus bas porte sur le
            # bon historique -- pas sur celui de l'identifiant precedent, ce qui
            # produirait un "vous avez modifie..." absurde pour un nouvel
            # utilisateur sans aucun historique.
            prev = load_last_settings(subject_id)
            base = prev if prev is not None else _blank_settings(subject_id, lang)
            want_modify = True
        else:
            base = prev
    else:
        subject_id = last_id
        base = _blank_settings(subject_id, lang)
        want_modify = True

    base.subject_id = subject_id
    base.language = lang

    profile = None
    if want_modify:
        edited = _ask_full_settings_confirmed(lang, base, prev)
        if edited is None:
            return None
        base, profile = edited
    else:
        # Reglages memorises acceptes tels quels : on revalide silencieusement
        # le materiel (l'ecran ou la distance ont pu changer depuis) et on ne
        # rouvre une fenetre que si cette revalidation echoue.
        screens = detect_screens()
        chosen = next((s for s in screens if s["index"] == base.screen_index), screens[0])
        if validate_resolution(chosen["width_px"], chosen["height_px"]) and classify_diagonal(base.screen_diagonal_in) != "reject":
            candidate_profile = build_screen_profile(
                base.screen_index, chosen["width_px"], chosen["height_px"],
                base.screen_diagonal_in, base.screen_width_cm, base.viewing_distance_cm,
            )
            fit = check_stimulus_fits(candidate_profile.px_per_deg, candidate_profile.width_px,
                                       candidate_profile.height_px, base.stim_h_deg, base.stim_v_deg)
            if candidate_profile.dot_size_px >= MIN_DOT_SIZE_PX and fit["ok"]:
                profile = candidate_profile
        if profile is None:
            logger.info("Reglages memorises non valides sur le materiel actuel -- reouverture de la configuration.")
            edited = _ask_full_settings_confirmed(lang, base, prev)
            if edited is None:
                return None
            base, profile = edited

    diffs = diff_settings(prev, base)
    if diffs:
        logger.info("Ecarts par rapport a la derniere seance de cet utilisateur : %s", diffs)

    # Verification physique de calibration : on ne la redemande QUE si le
    # profil ecran reellement resolu (resolution detectee + diagonale/largeur/
    # distance saisies) differe de celui pour lequel elle a deja ete confirmee
    # -- voir le commentaire sur SessionSettings.calibration_verified.
    if (profile is not None and prev is not None and prev.calibration_verified
            and profile.width_px == prev.calib_verified_width_px
            and profile.height_px == prev.calib_verified_height_px
            and profile.diagonal_in == prev.calib_verified_diagonal_in
            and profile.width_cm == prev.calib_verified_width_cm
            and profile.viewing_distance_cm == prev.calib_verified_distance_cm):
        base.calibration_verified = True
        base.calib_verified_width_px = prev.calib_verified_width_px
        base.calib_verified_height_px = prev.calib_verified_height_px
        base.calib_verified_diagonal_in = prev.calib_verified_diagonal_in
        base.calib_verified_width_cm = prev.calib_verified_width_cm
        base.calib_verified_distance_cm = prev.calib_verified_distance_cm
        logger.info("Profil ecran identique a celui deja verifie au metre -- verification physique non redemandee.")
    else:
        base.calibration_verified = False
        if prev is not None and prev.calibration_verified:
            logger.info("Profil ecran different de celui deja verifie au metre -- nouvelle verification physique requise.")

    save_settings(base, logger)
    _save_last_subject_id(base.subject_id, logger)
    return base, profile

