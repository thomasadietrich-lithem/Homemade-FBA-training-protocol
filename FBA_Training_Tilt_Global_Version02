def setup_logging(subject_id: str, session_num: int, timestamp: _dt.datetime) -> logging.Logger:
    """Cree un fichier de log dedie a cette seance (utile pour le depannage a
    distance : on peut demander au patient d'envoyer ce fichier). Le detail
    complet (DEBUG) part dans le fichier ; seuls les messages INFO+ vont aussi
    dans la console pour ne pas la noyer."""
    log_dir = os.path.join(BASE_DIR, DATA_DIRNAME, LOGS_DIRNAME)
    os.makedirs(log_dir, exist_ok=True)
    basename = build_output_basename(subject_id, session_num, timestamp)
    log_path = os.path.join(log_dir, basename + ".log")

    logger = logging.getLogger(SOFTWARE_NAME)
    logger.setLevel(logging.DEBUG)
    logger.handlers.clear()
    logger.propagate = False

    fh = logging.FileHandler(log_path, encoding="utf-8")
    fh.setLevel(logging.DEBUG)
    fh.setFormatter(logging.Formatter("%(asctime)s [%(levelname)s] %(message)s"))
    logger.addHandler(fh)

    sh = logging.StreamHandler(sys.stdout)
    sh.setLevel(logging.INFO)
    sh.setFormatter(logging.Formatter("[%(levelname)s] %(message)s"))
    logger.addHandler(sh)

    logger.info("=== %s v%s -- nouvelle session ===", SOFTWARE_NAME, SOFTWARE_VERSION)
    logger.info("Sujet=%s Seance n#%d Fichier log=%s", subject_id, session_num, log_path)
    logger.info("Python=%s Plateforme=%s", sys.version.split()[0], platform.platform())
    return logger


def log_uncaught_exception(logger: logging.Logger, exc: BaseException) -> None:
    logger.error("Exception non geree : %s", exc)
    logger.error("%s", "".join(traceback.format_exception(type(exc), exc, exc.__traceback__)))

# -----------------------------------------------------------------------------
# Calibration ecran : detection multi-moniteur, conversion deg<->px, garde-fous
# -----------------------------------------------------------------------------
# NOTE DE FIDELITE : la formule de conversion degres<->pixels ci-dessous reproduit
# volontairement l'approximation lineaire "flat screen" utilisee par le MATLAB
# d'origine (angle = atand(demi-largeur_cm / distance_cm), applique uniformement
# sur tout l'ecran). Cette approximation sous-estime legerement l'angle reel aux
# fortes excentricites (~10% d'erreur en bord d'ecran a distance rapprochee), mais
# la corriger romprait la fidelite avec les seuils/normes obtenus avec le
# programme MATLAB. A ne changer qu'apres discussion explicite.

@dataclass
class ScreenProfile:
    screen_index: int
    width_px: int
    height_px: int
    width_cm: float
    height_cm: float
    diagonal_in: float
    viewing_distance_cm: float
    px_per_deg: float
    dot_size_px: float


def _screen_matches(s, other) -> bool:
    """Compare deux ecrans pyglet par VALEUR (largeur/hauteur/position), pas
    par identite d'objet Python. CORRECTIF : get_screens() et
    get_default_screen() peuvent (et, constate en pratique, le font) renvoyer
    des INSTANCES DIFFERENTES pour le meme ecran physique -- un test `is`
    echoue alors systematiquement, et TOUS les ecrans (y compris le veritable
    ecran principal) se retrouvaient etiquetes "secondaire"."""
    if other is None:
        return False
    return (getattr(s, "width", None) == getattr(other, "width", None)
            and getattr(s, "height", None) == getattr(other, "height", None)
            and getattr(s, "x", None) == getattr(other, "x", None)
            and getattr(s, "y", None) == getattr(other, "y", None))


def detect_screens() -> List[dict]:
    """Enumere les ecrans disponibles via pyglet (necessaire pour le cas
    ordinateur portable + ecran externe branche). Retourne toujours au moins un
    element : en cas d'echec de detection, on retombe sur une valeur par defaut
    plutot que de bloquer le lancement."""
    try:
        import pyglet
        display = pyglet.canvas.get_display()
        screens = display.get_screens()
        try:
            default_screen = display.get_default_screen()
        except Exception:
            default_screen = screens[0] if screens else None
        out = []
        for i, s in enumerate(screens):
            out.append({
                "index": i,
                "width_px": int(s.width),
                "height_px": int(s.height),
                "x": int(s.x),
                "y": int(s.y),
                "is_primary": _screen_matches(s, default_screen),
            })
        if out:
            if not any(o["is_primary"] for o in out):
                # Filet de securite : si la comparaison par valeur ne trouve
                # aucune correspondance (get_default_screen indisponible ou
                # incoherent), ne jamais afficher une liste sans aucun ecran
                # principal -- on retient le premier par defaut.
                out[0]["is_primary"] = True
            return out
    except Exception:
        pass
    return [{
        "index": 0, "width_px": MIN_RESOLUTION_PX[0], "height_px": MIN_RESOLUTION_PX[1],
        "x": 0, "y": 0, "is_primary": True,
    }]


def validate_resolution(width_px: int, height_px: int) -> bool:
    return width_px >= MIN_RESOLUTION_PX[0] and height_px >= MIN_RESOLUTION_PX[1]


def classify_diagonal(diagonal_in: float) -> str:
    """'reject' sous le seuil minimal absolu (22po), 'warn' sous la
    recommandation (24po) mais au-dessus du seuil minimal, 'ok' sinon."""
    if diagonal_in < MIN_DIAGONAL_IN:
        return "reject"
    if diagonal_in < RECOMMENDED_DIAGONAL_IN:
        return "warn"
    return "ok"


def estimate_dpi(width_px: int, height_px: int, diagonal_in: float) -> float:
    """Densite de pixels (points/pouce) impliquee par la resolution detectee et
    la diagonale declaree par l'utilisateur. Heuristique de plausibilite
    uniquement (voir note pres de MIN_PLAUSIBLE_DPI) : ne prouve pas qu'un ecran
    est externe, mais detecte les combinaisons typiques d'une dalle
    d'ordinateur portable declaree avec une diagonale exageree."""
    if diagonal_in <= 0:
        return 0.0
    return math.sqrt(width_px ** 2 + height_px ** 2) / diagonal_in


def is_dpi_plausible(dpi: float) -> bool:
    return MIN_PLAUSIBLE_DPI <= dpi <= MAX_PLAUSIBLE_DPI


# Sorties DISPLAYCONFIG_VIDEO_OUTPUT_TECHNOLOGY (wingdi.h) considerees comme un
# ecran INTERNE (dalle integree). D'apres la documentation Microsoft elle-meme :
# "Values with 'embedded' in their names indicate that the [...] video output
# device connects internally to the display device. In those cases, the
# DISPLAYCONFIG_OUTPUT_TECHNOLOGY_INTERNAL value is redundant." -- autrement dit,
# la plupart des portables recents (connecteur eDP) remontent EMBEDDED, pas
# INTERNAL ; se limiter a INTERNAL manquerait la majorite du parc actuel.
_WIN_INTERNAL_OUTPUT_TECHNOLOGIES = {
    0x80000000,  # DISPLAYCONFIG_OUTPUT_TECHNOLOGY_INTERNAL
    11,          # DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EMBEDDED (eDP -- portables recents)
    13,          # DISPLAYCONFIG_OUTPUT_TECHNOLOGY_UDI_EMBEDDED
    6,           # DISPLAYCONFIG_OUTPUT_TECHNOLOGY_LVDS (portables plus anciens)
}


def detect_windows_internal_display() -> Optional[bool]:
    """Detection Windows REELLE (API CCD / QueryDisplayConfig, PAS une simple
    declaration de l'utilisateur) de la presence d'un ecran interne (dalle
    d'ordinateur portable) parmi les sorties actuellement actives.

    Retourne True si au moins une sortie active est identifiee comme interne,
    False si toutes les sorties actives sont clairement externes, ou None si
    la detection est impossible ou peu fiable (plateforme non-Windows, API
    absente, erreur quelconque) -- auquel cas l'appelant ne doit RIEN en
    conclure et se rabattre sur la case a cocher / l'heuristique DPI.

    AVERTISSEMENT DE FIABILITE : cette fonction s'appuie sur des structures
    ctypes reconstruites a partir de la documentation Microsoft officielle
    (DISPLAYCONFIG_PATH_INFO et ses sous-structures), mais n'a pas pu etre
    executee sur une machine Windows reelle pendant le developpement (environnement
    de developpement Linux sans affichage). Conformement au choix explicite de
    l'utilisateur, le resultat n'est donc utilise QUE comme avertissement
    supplementaire (jamais comme blocage dur) dans _ask_full_settings -- si cette
    detection se trompe, la pire consequence est un avertissement a tort ou une
    non-detection, jamais une application qui refuse de se lancer.

    NOTE TECHNIQUE : les champs utilisent des types ctypes a largeur FIXE
    (c_uint32/c_int32) plutot que ctypes.wintypes.DWORD/LONG/UINT/BOOL. Verifie
    empiriquement pendant le developpement : ces alias wintypes correspondent a
    C `long`/`unsigned long`, dont la taille depend de la plateforme (4 octets
    sur Windows LLP64, mais 8 octets constates sur Linux LP64 dans ce sandbox de
    developpement) -- un piege qui aurait fausse tout calcul de taille de
    structure fait ou verifie en dehors d'un vrai Windows. Les types a largeur
    fixe eliminent cette ambiguite quelle que soit la plateforme."""
    if platform.system() != "Windows":
        return None
    try:
        import ctypes

        U32 = ctypes.c_uint32
        I32 = ctypes.c_int32

        class _Luid(ctypes.Structure):
            _fields_ = [("LowPart", U32), ("HighPart", I32)]

        class _Rational(ctypes.Structure):
            _fields_ = [("Numerator", U32), ("Denominator", U32)]

        class _PathSourceInfo(ctypes.Structure):
            _fields_ = [
                ("adapterId", _Luid), ("id", U32),
                ("modeInfoIdxUnion", U32),  # union UINT32 <-> bitfields, meme taille
                ("statusFlags", U32),
            ]

        class _PathTargetInfo(ctypes.Structure):
            _fields_ = [
                ("adapterId", _Luid), ("id", U32),
                ("modeInfoIdxUnion", U32),
                ("outputTechnology", U32),
                ("rotation", U32), ("scaling", U32),
                ("refreshRate", _Rational), ("scanLineOrdering", U32),
                ("targetAvailable", I32), ("statusFlags", U32),
            ]

        class _PathInfo(ctypes.Structure):
            _fields_ = [
                ("sourceInfo", _PathSourceInfo), ("targetInfo", _PathTargetInfo),
                ("flags", U32),
            ]

        QDC_ONLY_ACTIVE_PATHS = 0x00000002
        ERROR_SUCCESS = 0
        ERROR_INSUFFICIENT_BUFFER = 122

        user32 = ctypes.windll.user32
        user32.GetDisplayConfigBufferSizes.argtypes = [
            U32, ctypes.POINTER(U32), ctypes.POINTER(U32)]
        user32.GetDisplayConfigBufferSizes.restype = I32
        user32.QueryDisplayConfig.argtypes = [
            U32, ctypes.POINTER(U32), ctypes.POINTER(_PathInfo),
            ctypes.POINTER(U32), ctypes.c_void_p, ctypes.c_void_p]
        user32.QueryDisplayConfig.restype = I32

        path_count = U32(0)
        mode_count = U32(0)
        for _attempt in range(3):
            rc = user32.GetDisplayConfigBufferSizes(
                QDC_ONLY_ACTIVE_PATHS, ctypes.byref(path_count), ctypes.byref(mode_count))
            if rc != ERROR_SUCCESS:
                return None
            path_array = (_PathInfo * max(1, path_count.value))()
            # DISPLAYCONFIG_MODE_INFO n'est jamais lu par ce code -- seule sa
            # TAILLE compte, pour que Windows dispose d'assez de place pour
            # ecrire. Plutot que de reconstruire de memoire toute la hierarchie
            # de structures imbriquees (DISPLAYCONFIG_TARGET_MODE / SOURCE_MODE /
            # DESKTOP_IMAGE_INFO, ~64 octets documentes), on sur-alloue
            # largement (128 octets/element) : une sous-estimation de cette
            # taille serait le principal risque reel de corruption memoire de
            # cette fonction, donc on l'elimine par une marge large plutot que
            # par une exactitude qu'on ne peut pas verifier dans cet environnement.
            mode_buf = ctypes.create_string_buffer(max(1, mode_count.value) * 128)
            rc = user32.QueryDisplayConfig(
                QDC_ONLY_ACTIVE_PATHS, ctypes.byref(path_count), path_array,
                ctypes.byref(mode_count), mode_buf, None)
            if rc == ERROR_INSUFFICIENT_BUFFER:
                continue  # la config a change entre les deux appels : on reessaie
            if rc != ERROR_SUCCESS:
                return None
            found_internal = False
            found_external = False
            for i in range(path_count.value):
                tech = path_array[i].targetInfo.outputTechnology
                if tech in _WIN_INTERNAL_OUTPUT_TECHNOLOGIES:
                    found_internal = True
                else:
                    found_external = True
            if found_internal:
                return True
            if found_external:
                return False
            return None
        return None
    except Exception:
        return None


def estimate_width_cm_from_diagonal(diagonal_in: float, width_px: int, height_px: int) -> float:
    """Estime la largeur physique (cm) a partir de la diagonale saisie et du
    ratio d'aspect de la resolution detectee.

    CORRECTIF (round 4, 27/08) : jusqu'au round precedent, laisser la
    largeur physique a 0 dans le formulaire invoquait explicitement cette
    estimation (libelle "laisser 0 pour estimer") -- retire a la demande de
    l'utilisateur, une mesure physique reelle est desormais obligatoire (voir
    _ask_full_settings, validation width_cm<=0). Cette fonction et son unique
    appelant (build_screen_profile) sont conserves tels quels UNIQUEMENT comme
    filet de securite pour d'anciens reglages deja sauvegardes avant ce
    correctif (fichier settings.json avec width_cm=0) -- sans ce filet,
    compute_px_per_deg diviserait par une largeur nulle (ZeroDivisionError) au
    prochain lancement silencieux de ce patient. Plus jamais atteignable
    depuis le formulaire pour une nouvelle saisie."""
    diagonal_cm = diagonal_in * 2.54
    aspect = (width_px / height_px) if height_px else (DEFAULT_ASPECT_W / DEFAULT_ASPECT_H)
    width_cm = diagonal_cm / math.sqrt(1.0 + (1.0 / aspect) ** 2)
    return width_cm


def compute_px_per_deg(screen_width_cm: float, viewing_distance_cm: float, screen_width_px: int) -> float:
    """Reproduit exactement scale_factor = atand(largeur/2/distance)*60/(resX/2)
    du MATLAB d'origine, reformule en pixels-par-degre."""
    half_width_deg = math.degrees(math.atan((screen_width_cm / 2.0) / viewing_distance_cm))
    arcmin_per_px = (half_width_deg * 60.0) / (screen_width_px / 2.0)
    deg_per_px = arcmin_per_px / 60.0
    return 1.0 / deg_per_px


def deg2px(deg: float, px_per_deg: float) -> float:
    return deg * px_per_deg


def px2deg(px: float, px_per_deg: float) -> float:
    return px / px_per_deg


def compute_dot_size_px(px_per_deg: float) -> float:
    dot_size_deg = DOT_SIZE_ARCMIN / 60.0
    return dot_size_deg * px_per_deg


def check_stimulus_fits(px_per_deg: float, screen_width_px: int, screen_height_px: int,
                         stim_h_deg: float, stim_v_deg: float) -> dict:
    """Verifie que le stimulus (centre du patch + rayon d'aperture) reste
    entierement dans le champ visible, sur les deux axes."""
    half_w_deg = (screen_width_px / 2.0) / px_per_deg
    half_h_deg = (screen_height_px / 2.0) / px_per_deg
    needed_h = abs(stim_h_deg) + APERTURE_RADIUS_DEG
    needed_v = abs(stim_v_deg) + APERTURE_RADIUS_DEG
    return {
        "ok": (needed_h <= half_w_deg) and (needed_v <= half_h_deg),
        "half_w_deg": half_w_deg,
        "half_h_deg": half_h_deg,
        "needed_h_deg": needed_h,
        "needed_v_deg": needed_v,
    }


def build_screen_profile(screen_index: int, width_px: int, height_px: int,
                          diagonal_in: float, width_cm_input: float,
                          viewing_distance_cm: float) -> ScreenProfile:
    """Construit un profil ecran complet a partir des saisies utilisateur,
    en estimant la largeur physique si necessaire."""
    if width_cm_input and width_cm_input > 0:
        width_cm = width_cm_input
        height_cm = width_cm * (height_px / width_px)
    else:
        width_cm = estimate_width_cm_from_diagonal(diagonal_in, width_px, height_px)
        height_cm = width_cm * (height_px / width_px)
    px_per_deg = compute_px_per_deg(width_cm, viewing_distance_cm, width_px)
    dot_px = compute_dot_size_px(px_per_deg)
    return ScreenProfile(
        screen_index=screen_index, width_px=width_px, height_px=height_px,
        width_cm=width_cm, height_cm=height_cm, diagonal_in=diagonal_in,
        viewing_distance_cm=viewing_distance_cm, px_per_deg=px_per_deg, dot_size_px=dot_px,
    )

# -----------------------------------------------------------------------------
# Geometrie direction/orientation/touche-reponse (coeur scientifique du script)
# -----------------------------------------------------------------------------
# Reproduit fidelement les lignes 373-428 de HuxlinLabFBAtraining.m :
#   direction   in {1,2}      (ci-dessous : base_side)   -- tirage 50/50
#   orientation in {-1,+1}    (ci-dessous : tilt_sign)    -- tirage 50/50 independant
#   angle = f(angle_set, base_side) + angle_deviationP * tilt_sign   (convention
#           Psychtoolbox : 0=+x, +y=BAS, angle croissant = rotation "horaire" a
#           l'ecran)
#
# IMPORTANT -- lu et re-verifie ligne a ligne sur le MATLAB d'origine : la table
# de correspondance angle_set=1 (reponse Gauche/Droite) de HuxlinLabFBAtraining.m
# est elle-meme INCOHERENTE pour base_side==2 (le mouvement affiche part parfois
# a gauche alors que la touche jugee correcte est Droite, et vice-versa -- verifie
# par calcul direct : angle=90+85=175 deg -> vecteur (-0.996,+0.087) = mouvement
# VISUELLEMENT VERS LA GAUCHE, alors que le code MATLAB attend la touche Droite
# pour orientation=+1 dans ce cas). Ce script ne reproduit PAS cette table par
# copie : la touche correcte est TOUJOURS deduite geometriquement du vecteur
# reellement affiche (vx,vy ci-dessous), ce qui la rend automatiquement
# coherente pour les DEUX modes (angle_set 0 et 1), sans avoir a trancher quelle
# moitie d'une table auto-contradictoire serait "la bonne". Comme angle_set=1
# n'est utilise qu'occasionnellement en pratique (cf. echanges avec
# l'utilisateur), cet ecart deliberement assume vis-a-vis de MATLAB est sans
# risque et strictement une amelioration (aucun patient ne doit voir une
# consigne clavier qui contredit ce qu'il voit a l'ecran).
#
# Pour angle_set=0 (Haut/Bas, le mode reellement utilise), la meme verification
# ligne a ligne confirme que MATLAB est deja parfaitement auto-coherent dans les
# 4 cas -- la regle geometrique ci-dessous reproduit donc EXACTEMENT le
# comportement MATLAB pour ce mode, pas seulement un choix "raisonnable".
#
# Convention de ce script : vx,vy sont calcules directement comme
# cos(angle)/sin(angle) SANS inversion de signe, et utilises tels quels aussi
# bien pour le rendu (deplacement des points, en unites PsychoPy +y=HAUT) que
# pour la deduction de la touche correcte. Le sens visuel resultant pour un
# couple (base_side,tilt_sign) donne est donc en "miroir vertical" par rapport
# a MATLAB -- verifie SANS CONSEQUENCE par l'utilisateur sur plusieurs dizaines
# de sessions (voir echanges) : rendu et notation restent toujours coherents
# entre eux, et les proportions Haut/Bas (ou Gauche/Droite) restent 50/50. Ne
# pas modifier ce choix sans en rediscuter explicitement.

@dataclass
class TrialDirection:
    base_side: int          # 1 ou 2 (MATLAB "direction")
    tilt_sign: int           # -1 ou +1 (MATLAB "orientation")
    angle_dev_deg: float      # difficulte de cet essai (angle_deviationP)
    angle_deg: float          # angle absolu, convention Psychtoolbox (voir ci-dessus)
    vx: float                  # composante x du vecteur unitaire, convention PsychoPy (+x=droite)
    vy: float                  # composante y du vecteur unitaire, convention PsychoPy (+y=HAUT)
    correct_key: str
    incorrect_key: str


def compute_trial_direction(angle_set: int, base_side: int, tilt_sign: int, angle_dev_deg: float) -> TrialDirection:
    if angle_set == 0 and base_side == 1:
        angle_deg = 0.0 + angle_dev_deg * tilt_sign
    elif angle_set == 0 and base_side == 2:
        angle_deg = 180.0 + angle_dev_deg * tilt_sign
    elif angle_set == 1 and base_side == 1:
        angle_deg = 270.0 + angle_dev_deg * tilt_sign
    else:
        angle_deg = 90.0 + angle_dev_deg * tilt_sign

    angle_rad = math.radians(angle_deg)
    vx = math.cos(angle_rad)
    vy = math.sin(angle_rad)

    if angle_set == 0:
        correct_key, incorrect_key = ("up", "down") if vy > 0 else ("down", "up")
    else:
        correct_key, incorrect_key = ("right", "left") if vx > 0 else ("left", "right")

    return TrialDirection(
        base_side=base_side, tilt_sign=tilt_sign, angle_dev_deg=angle_dev_deg,
        angle_deg=angle_deg, vx=vx, vy=vy, correct_key=correct_key, incorrect_key=incorrect_key,
    )


def compute_precue_geometry(base_side: int, angle_dev_deg: float,
                             screen_width_px: int) -> Tuple[Tuple[float, float], Tuple[float, float]]:
    """Reproduit les deux Screen('DrawLine', ...) de la precue en chevron de
    HuxlinLabFBAtraining.m (mise a jour du 10/05/21, lignes 484-495) : deux
    segments DROITS partageant un point de depart (le point de fixation),
    dont l'ouverture (ecart angulaire par rapport a l'horizontale) est dans
    le MATLAB d'origine directement angle_dev_deg -- SANS plancher reel (le
    seul code de "plancher" du fichier source, la variable `yy` aux lignes
    477-482, est calcule mais jamais lu ensuite ; le rendu du chevron utilise
    bien angle_deviationP brut). Le cue pointe a DROITE quand base_side==1, a
    GAUCHE quand base_side==2 -- ceci est INCONDITIONNEL par rapport a
    angle_set dans le MATLAB d'origine (le code de la precue ne teste jamais
    angle_set), et ce script reproduit fidelement cette meme absence de
    branchement plutot que d'inventer un comportement "vertical" que MATLAB
    n'a jamais eu.

    DEVIATION ASSUMEE (voir PRECUE_MIN_OPENING_DEG) : contrairement au MATLAB
    source, l'angle utilise pour l'OUVERTURE VISUELLE du chevron est plafonne
    a PRECUE_MIN_OPENING_DEG -- demande explicitement apres qu'un test reel a
    confirme que la fidelite stricte (chevron qui retrecit jusqu'a 0.5 deg,
    les deux segments se confondant visuellement) rendait la precue peu
    lisible aux essais difficiles. Ce plancher n'affecte QUE la geometrie du
    cue ; angle_deg (la vraie direction du mouvement affiche, calculee dans
    compute_trial_direction) reste exactement fidele au niveau de difficulte
    du staircase, sans aucun plancher.

    Retourne les deux points d'arrivee des segments (bras superieur, bras
    inferieur) EN PIXELS, relatifs a la fixation, convention PsychoPy
    (+x=droite, +y=haut). CORRECTIF DE FIDELITE (independant du point
    ci-dessus) : la formule MATLAB d'origine (resolution(1)/cue_scale) est
    NATIVEMENT en pixels ; ce script gardait par erreur une conversion
    superflue vers les degres (division par px_per_deg) alors que le point
    d'appel additionnait ensuite ce resultat directement a une position deja
    en pixels -- ce qui reduisait la precue a une fraction de pixel, donc
    invisible a l'ecran. La fonction travaille desormais en pixels de bout en
    bout, sans aucune conversion, exactement comme MATLAB.

    DEVIATION ASSUMEE (voir PRECUE_LENGTH_MULTIPLIER) : la longueur des bras
    (r_px) est ensuite multipliee par ce facteur -- demande explicitement le
    27/08 pour ameliorer la lisibilite. La formule MATLAB fidele
    (resolution(1)/cue_scale) reste calculee en premier et clairement isolee
    ci-dessous ; seul le resultat final est mis a l'echelle."""
    side = 1.0 if base_side == 1 else -1.0
    r_px = (screen_width_px / CUE_SCALE) * PRECUE_LENGTH_MULTIPLIER
    opening_deg = max(angle_dev_deg, PRECUE_MIN_OPENING_DEG)
    dev_rad = math.radians(opening_deg)
    dx = side * r_px * math.cos(dev_rad)
    dy = r_px * math.sin(dev_rad)
    return (dx, dy), (dx, -dy)


def run_self_consistency_check() -> None:
    """Garde-fou de non-regression execute au demarrage (voir main()) : pour les
    8 combinaisons possibles de (angle_set, base_side, tilt_sign), verifie que
    la touche jugee correcte correspond bien au signe reel du vecteur affiche
    (vy pour l'axe vertical, vx pour l'axe horizontal), et que la repartition
    Haut/Bas (resp. Gauche/Droite) est bien equilibree 2/2 sur les 4 cas de
    chaque mode. Cette propriete est vraie par construction (le meme calcul
    alimente le rendu ET le jugement) -- ce test sert a empecher qu'une
    modification future ne casse ce lien (ex. en codant en dur une table de
    correspondance plutot qu'en la deduisant du vecteur reel), ce qui serait
    decouvert ici au demarrage plutot que par un patient en seance."""
    counts = {"up": 0, "down": 0, "left": 0, "right": 0}
    for angle_set in (0, 1):
        for base_side in (1, 2):
            for tilt_sign in (-1, 1):
                td = compute_trial_direction(angle_set, base_side, tilt_sign, 45.0)
                if td.correct_key == td.incorrect_key:
                    raise AssertionError(f"correct_key == incorrect_key pour {td!r}")
                if angle_set == 0:
                    if td.correct_key not in ("up", "down"):
                        raise AssertionError(f"touche inattendue pour angle_set=0 : {td!r}")
                    if (td.vy > 0) != (td.correct_key == "up"):
                        raise AssertionError(f"Incoherence vy/touche : {td!r}")
                else:
                    if td.correct_key not in ("left", "right"):
                        raise AssertionError(f"touche inattendue pour angle_set=1 : {td!r}")
                    if (td.vx > 0) != (td.correct_key == "right"):
                        raise AssertionError(f"Incoherence vx/touche : {td!r}")
                counts[td.correct_key] += 1
    if not (counts["up"] == counts["down"] == 2):
        raise AssertionError(f"Desequilibre Haut/Bas : {counts!r}")
    if not (counts["left"] == counts["right"] == 2):
        raise AssertionError(f"Desequilibre Gauche/Droite : {counts!r}")


def run_geometry_roundtrip_check() -> None:
    """Verifie que deg2px/px2deg sont bien inverses l'une de l'autre, pour
    detecter toute regression future dans les helpers de conversion."""
    px_per_deg = compute_px_per_deg(SCREEN_WIDTH_CM_DEFAULT, VIEWING_DISTANCE_CM_DEFAULT, MIN_RESOLUTION_PX[0])
    for deg in (0.0, 0.5, 2.5, 10.0, -7.3):
        px = deg2px(deg, px_per_deg)
        back = px2deg(px, px_per_deg)
        if abs(back - deg) > SELF_TEST_TOLERANCE * max(1.0, abs(deg)) * 1e6:
            raise AssertionError(f"Aller-retour deg<->px incoherent pour {deg} : {back}")


def run_startup_self_tests(logger: Optional[logging.Logger] = None) -> None:
    """Point d'entree unique des auto-tests executes a chaque lancement, avant
    l'ouverture de la fenetre PsychoPy. Toute levee d'exception ici doit
    empecher le demarrage de la seance (mieux vaut un plantage explicite au
    lancement qu'une seance scientifiquement invalide)."""
    run_self_consistency_check()
    run_geometry_roundtrip_check()
    if not translations_are_complete():
        raise AssertionError("Dictionnaire de traduction incomplet (voir translations_are_complete).")
    if logger is not None:
        logger.info("Auto-tests de demarrage : OK (coherence direction/touche, geometrie, traductions).")

# -----------------------------------------------------------------------------
# Stimulus RDK (Random Dot Kinematogram) -- coherence globale 100% ("Tilt_Global")
# -----------------------------------------------------------------------------
# Reproduit fidelement les lignes 244-256 et 509-552 de HuxlinLabFBAtraining.m,
# y compris des details d'implementation qui n'ont pas d'impact statistique
# demontrable mais sont repris pour eliminer tout ecart residuel :
#  - le carre d'echantillonnage/rejet fait bps = 2*rayon+1 px (pas 2*rayon) ;
#  - le "wrap" aux bords utilise une chaine if/elif/elif/elif (un seul axe
#    corrige par point et par frame, jamais les deux) ;
#  - la duree de vie des points (lifetime) reste un nombre de frames FLOTTANT
#    (pas arrondi), compare avec > a un age entier -- exactement comme
#    `age{j}(i) > lifetime` en MATLAB ;
#  - le mouvement (vx,vy) est rigoureusement IDENTIQUE pour tous les points
#    (normrnd(0,0,...) = zero variance = coherence globale a 100%, PAS de bruit
#    directionnel point-a-point -- c'est ce qui distingue "Tilt_Global" de
#    Coarse_dots).

def compute_n_dots(aperture_radius_deg: float, dot_density_per_deg2: float) -> int:
    return int(round((aperture_radius_deg ** 2) * math.pi * dot_density_per_deg2))


def generate_initial_dot_state(n_dots: int, radius_px: float, lifetime_frames: float) -> Tuple[np.ndarray, np.ndarray]:
    """positions{1} / age{1} : tirage uniforme par rejet dans le disque
    d'aperture, age initial uniforme entre 1 et lifetime_frames (evite un
    "pouls" synchrone de tous les points a la meme frame)."""
    bps = radius_px * 2.0 + 1.0
    positions = np.zeros((n_dots, 2), dtype=float)
    for i in range(n_dots):
        while True:
            x = (np.random.rand() - 0.5) * bps
            y = (np.random.rand() - 0.5) * bps
            if x * x + y * y <= radius_px * radius_px:
                positions[i, 0] = x
                positions[i, 1] = y
                break
    ages = np.ceil(np.random.rand(n_dots) * max(lifetime_frames, 1.0))
    ages = np.maximum(ages, 1.0)
    return positions, ages


def advance_dot_frame(positions: np.ndarray, ages: np.ndarray, vx_unit: float, vy_unit: float,
                       step_px: float, radius_px: float, lifetime_frames: float) -> Tuple[np.ndarray, np.ndarray]:
    """Calcule positions{j}/age{j} a partir de positions{j-1}/age{j-1} (une
    frame de mouvement), en reproduisant l'ordre exact des operations des
    lignes 523-552 : deplacement -> vieillissement -> respawn si trop vieux ->
    wrap (if/elif) -> rejet-et-redraw si toujours hors du disque."""
    bps = radius_px * 2.0 + 1.0
    n_dots = positions.shape[0]
    new_positions = np.empty_like(positions)
    new_ages = np.empty_like(ages)
    for i in range(n_dots):
        x = positions[i, 0] + step_px * vx_unit
        y = positions[i, 1] + step_px * vy_unit
        age = ages[i] + 1.0

        if age > lifetime_frames:
            x = (np.random.rand() - 0.5) * bps
            y = (np.random.rand() - 0.5) * bps
            age = 1.0

        if x > radius_px:
            x -= bps
        elif x < -radius_px:
            x += bps
        elif y > radius_px:
            y -= bps
        elif y < -radius_px:
            y += bps

        if x * x + y * y > radius_px * radius_px:
            while True:
                rx = (np.random.rand() - 0.5) * bps
                ry = (np.random.rand() - 0.5) * bps
                if rx * rx + ry * ry <= radius_px * radius_px:
                    x, y = rx, ry
                    break

        new_positions[i, 0] = x
        new_positions[i, 1] = y
        new_ages[i] = age
    return new_positions, new_ages


def precompute_trial_frames(n_dots: int, radius_px: float, lifetime_frames: float, vx_unit: float,
                             vy_unit: float, step_px: float, mv_length: int) -> List[np.ndarray]:
    """Precalcule la totalite des positions de la frame 1 (statique, comme
    MATLAB : positions{1} n'est jamais deplace) a la frame mv_length. Ce calcul
    est fait EN UNE FOIS, avant le debut de l'animation, pour pouvoir etre
    absorbe dans le delai d'ISI compense (voir run_trial) exactement comme
    MATLAB le fait avant son "Finish the ITI"."""
    positions, ages = generate_initial_dot_state(n_dots, radius_px, lifetime_frames)
    frames = [positions.copy()]
    for _ in range(2, mv_length + 1):
        positions, ages = advance_dot_frame(positions, ages, vx_unit, vy_unit, step_px, radius_px, lifetime_frames)
        frames.append(positions.copy())
    return frames


# -----------------------------------------------------------------------------
# Staircases 3-descendant / 1-montant entrelacees
# -----------------------------------------------------------------------------
# Reproduit fidelement les lignes 322-328 (repartition + mixage fixe des essais
# entre les 3 staircases) et 430-462 / 595-636 (regle de progression) de
# HuxlinLabFBAtraining.m. Point de fidelite important, verifie ligne a ligne :
# en MATLAB, le passage au niveau superieur apres 3 succes consecutifs n'est
# APPLIQUE qu'au prochain passage sur cette meme staircase (pas au moment du
# 3e succes lui-meme), alors qu'un echec fait immediatement reculer le niveau,
# des la reponse. Les deux fonctions ci-dessous respectent cette asymetrie de
# timing plutot que de fusionner les deux mises a jour au meme moment.

def build_stair_sequence(n_trials_per_staircase: int, n_staircases: int = N_STAIRCASES) -> List[int]:
    """Reproduit stair_array : n_trials_per_staircase copies de chaque
    staircase (1..n_staircases), puis un unique melange global -- une sequence
    fixe pour toute la seance ou chaque staircase apparait exactement
    n_trials_per_staircase fois (pas un tirage aleatoire independant par essai,
    qui ne garantirait pas l'egalite des effectifs)."""
    seq: List[int] = []
    for s in range(1, n_staircases + 1):
        seq.extend([s] * n_trials_per_staircase)
    np.random.shuffle(seq)
    return seq


def maybe_advance_staircase(stair_idxs: List[int], streak_counts: List[int], which_stair: int, n_levels: int) -> None:
    """A appeler en tout DEBUT de traitement d'un essai, avant de lire la
    difficulte de CET essai (lignes 430-451 de HuxlinLabFBAtraining.m)."""
    idx = which_stair - 1
    if streak_counts[idx] == STAIRCASE_UP_STREAK:
        stair_idxs[idx] = min(stair_idxs[idx] + 1, n_levels - 1)
        streak_counts[idx] = 0


def record_staircase_response(stair_idxs: List[int], streak_counts: List[int], which_stair: int,
                               correct: bool, n_levels: int) -> None:
    """A appeler juste apres avoir note la reponse (lignes 595-636). Echec ->
    niveau plus facile IMMEDIATEMENT (plancher = niveau 0). Succes -> incremente
    seulement le compteur de serie ; le passage au niveau superieur est
    applique au prochain passage sur cette staircase (maybe_advance_staircase)."""
    idx = which_stair - 1
    if correct:
        streak_counts[idx] += 1
    else:
        stair_idxs[idx] = max(stair_idxs[idx] - 1, 0)
        streak_counts[idx] = 0

# -----------------------------------------------------------------------------
# NOTE DE FIDELITE IMPORTANTE -- unites PsychoPy utilisees dans toute la suite
# -----------------------------------------------------------------------------
# PsychoPy convertit nativement ses unites 'deg' vers les pixels avec une formule
# EXACTE en tangente (deg2cm = distance*tan(radians(deg))), differente de
# l'approximation lineaire "ecran plat" utilisee par MATLAB et reproduite dans
# compute_px_per_deg() ci-dessus. Pour eviter tout ecart, meme infime, entre "ou
# PsychoPy pense qu'un degre se trouve" et "ou ce script pense qu'un degre se
# trouve", TOUTE la geometrie (positions, tailles, cue) est calculee explicitement
# en pixels via deg2px()/px2deg() (formule MATLAB), et TOUS les stimuli PsychoPy
# sont crees avec units='pix'. Les unites 'deg' natives de PsychoPy ne sont
# JAMAIS utilisees pour le rendu, uniquement pour l'affichage/la saisie cote
# utilisateur (dialogues, resume).


def compute_calibration_check(profile: "ScreenProfile", settings: "SessionSettings") -> Dict[str, float]:
    """Reproduit le calcul de verification physique de l'ecran d'accueil MATLAB
    (test_size/test_size2, lignes 343-344) : taille de la zone de stimulation et
    distance fixation->stimulus, en cm et en pouces, pour verification a la
    regle par le patient/l'accompagnant."""
    aperture_diam_px = 2.0 * deg2px(APERTURE_RADIUS_DEG, profile.px_per_deg)
    px_per_cm = profile.width_px / profile.width_cm
    box_cm = aperture_diam_px / px_per_cm
    box_in = box_cm * 0.3937

    fix_x_px = deg2px(settings.fixation_h_deg, profile.px_per_deg)
    fix_y_px = deg2px(settings.fixation_v_deg, profile.px_per_deg)
    stim_x_px = deg2px(settings.stim_h_deg, profile.px_per_deg)
    stim_y_px = deg2px(settings.stim_v_deg, profile.px_per_deg)
    line_px = math.hypot(stim_x_px - fix_x_px, stim_y_px - fix_y_px)
    line_cm = line_px / px_per_cm
    line_in = line_cm * 0.3937

    return {"box_cm": box_cm, "box_in": box_in, "line_cm": line_cm, "line_in": line_in}


def compute_actual_trial_counts(requested_total: int, n_staircases: int = N_STAIRCASES) -> Tuple[int, int]:
    """Le nombre total d'essais demande par l'utilisateur est ajuste au multiple
    de n_staircases le plus proche (chaque staircase doit recevoir exactement le
    meme nombre d'essais, comme n_trials*n_staircases en MATLAB). Retourne
    (essais_par_staircase, total_reel)."""
    per_staircase = max(1, round(requested_total / n_staircases))
    return per_staircase, per_staircase * n_staircases


def compute_pause_trial_indices(pause_mode: int, total_trials: int) -> List[int]:
    """Fonctionnalite nouvelle (absente de MATLAB) : indices d'essai (1-based)
    APRES lesquels une pause programmee est proposee."""
    if pause_mode == 1:
        return [total_trials // 2]
    if pause_mode == 2:
        return [total_trials // 3, (2 * total_trials) // 3]
    return []


@dataclass
class TrialRecord:
    trial: int
    staircase_id: int
    angle_dev_deg: float
    base_side: int
    tilt_sign: int
    angle_deg: float
    correct_key: str
    key_pressed: str
    is_correct: int
    rt_s: float
    # AJOUT PAR RAPPORT A MATLAB (27/08) : 1 si check_movement_timing() a
    # detecte un ecart de cadence significatif pendant l'affichage du
    # mouvement de cet essai, 0 sinon. Voir TIMING_ANOMALY_THRESHOLD.
    timing_anomaly: int = 0


@dataclass
class SessionOutcome:
    trials: List[TrialRecord] = field(default_factory=list)
    aborted: bool = False
    error: Optional[str] = None
    total_time_s: float = 0.0
    total_trials_planned: int = 0
    final_stair_idxs: List[int] = field(default_factory=list)
    frame_rate_measured: float = 0.0
    calibration_check: Dict[str, float] = field(default_factory=dict)
    # AJOUTS PAR RAPPORT A MATLAB (27/08), voir run_performance_check /
    # check_power_source_change : perf_check_failed = la seance n'a pas
    # demarre car la verification initiale de performance a echoue (E10) ;
    # power_source_changed = un changement secteur/batterie a ete detecte
    # pendant la seance reelle (E11, avertissement non bloquant).
    perf_check_failed: bool = False
    power_source_changed: bool = False

    @property
    def n_completed(self) -> int:
        return len(self.trials)

    @property
    def n_correct(self) -> int:
        return sum(r.is_correct for r in self.trials)

    @property
    def accuracy_percent(self) -> float:
        return (100.0 * self.n_correct / self.n_completed) if self.trials else float("nan")

    @property
    def final_threshold_deg(self) -> float:
        if not self.final_stair_idxs:
            return float("nan")
        return float(np.mean([ANGLE_RANGE_DEG[i] for i in self.final_stair_idxs]))


