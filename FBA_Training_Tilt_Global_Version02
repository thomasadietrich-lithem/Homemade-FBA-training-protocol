def diff_settings(old: Optional[SessionSettings], new: SessionSettings) -> List[Tuple[str, str, str]]:
    """Retourne une liste (libelle_traduit, ancienne_valeur, nouvelle_valeur) pour
    chaque champ surveille qui differe de la derniere seance de ce patient."""
    if old is None:
        return []
    diffs = []
    old_d, new_d = old.to_dict(), new.to_dict()
    for key in _DIFF_WATCHED_FIELDS:
        if old_d.get(key) != new_d.get(key):
            diffs.append((key, str(old_d.get(key)), str(new_d.get(key))))
    return diffs


