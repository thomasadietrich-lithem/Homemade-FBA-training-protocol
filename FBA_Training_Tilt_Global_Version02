def build_session_sounds(logger: Optional[logging.Logger] = None) -> Dict[str, object]:
    """Construit les tonalites de retour. En cas d'echec d'initialisation audio
    (pas de peripherique de son disponible), retourne des valeurs None : la
    seance continue silencieusement plutot que de planter -- l'audio est juge
    non essentiel a la validite de l'exercice (retour visuel deja present a
    l'ecran). AJOUT PAR RAPPORT A MATLAB (27/08) : l'echec est desormais
    journalise (code E13) au lieu d'etre totalement silencieux, suite a une
    demande explicite de repertorier "tout autre erreur commune (meme
    probleme son, ou audio...)". Toujours pas de popup : voir constante
    ERR_CODE_AUDIO."""
    out: Dict[str, object] = {}
    for key, freq, dur in (
        ("start", START_TONE_HZ, 0.05),
        ("correct", CORRECT_TONE_HZ, 0.12),
        ("incorrect", INCORRECT_TONE_HZ, 0.12),
        ("pause", PAUSE_TONE_HZ, PAUSE_TONE_DURATION_S),
    ):
        try:
            out[key] = sound.Sound(value=freq, secs=dur)
        except Exception as exc:
            out[key] = None
            if logger is not None:
                logger.warning("[%s] Peripherique audio indisponible pour le son '%s' : %s", ERR_CODE_AUDIO, key, exc)
    return out


def _play(snd: object, logger: Optional[logging.Logger] = None) -> None:
    if snd is not None:
        try:
            snd.play()  # type: ignore[attr-defined]
        except Exception as exc:
            if logger is not None:
                logger.warning("[%s] Echec de lecture d'un son de retour : %s", ERR_CODE_AUDIO, exc)


def show_escape_pause_screen(win: "visual.Window", lang: str, trial_index: int, total_trials: int) -> bool:
    """Reproduit l'ecran de pause Echap (lignes 637-657 de
    HuxlinLabFBAtraining.m) : efface l'ecran, attend 0.2s (anti-rebond), affiche
    le message de pause, puis attend une touche quelconque. Retourne True si
    l'utilisateur a confirme vouloir quitter (Echap a nouveau)."""
    win.flip()
    core.wait(ESCAPE_DEBOUNCE_S)
    txt = visual.TextStim(
        win,
        text=t("escape_paused_title", lang) + "\n\n" + t("escape_paused_text", lang, trial=trial_index, total=total_trials),
        color=TEXT_COLOR_RGB, height=26, wrapWidth=900, units="pix", pos=(0, 0),
    )
    event.clearEvents(eventType="keyboard")
    txt.draw()
    win.flip()
    keys = event.waitKeys(keyList=None)
    return bool(keys) and keys[0] == "escape"


def do_scheduled_pause(win: "visual.Window", sounds: Dict[str, object], lang: str,
                        trial_index: int, total_trials: int,
                        logger: Optional[logging.Logger] = None) -> bool:
    """Pause programmee configurable (fonctionnalite nouvelle, absente de
    MATLAB) : decompte d'une minute maximum affiche a l'ecran, ESPACE reprend
    immediatement, un signal sonore distinct marque le debut de la pause.
    Retourne True si l'utilisateur a demande a quitter definitivement."""
    _play(sounds.get("pause"), logger)
    pause_clock = core.Clock()
    pause_text = visual.TextStim(win, text="", color=TEXT_COLOR_RGB, height=28, wrapWidth=900, units="pix", pos=(0, 0))
    event.clearEvents(eventType="keyboard")
    while True:
        remaining = max(0.0, SCHEDULED_PAUSE_DURATION_S - pause_clock.getTime())
        pause_text.text = t("pause_title", lang) + "\n\n" + t("pause_text", lang, secs=int(math.ceil(remaining)))
        pause_text.draw()
        win.flip()
        keys = event.getKeys(keyList=["space", "escape"])
        if "escape" in keys:
            if show_escape_pause_screen(win, lang, trial_index, total_trials):
                return True
            pause_clock.reset()
            event.clearEvents(eventType="keyboard")
            continue
        if "space" in keys or remaining <= 0.0:
            return False


def check_movement_timing(movement_duration_s: float, mv_length: int, frame_ms: float,
                           logger: logging.Logger, trial_index: int) -> bool:
    """Compare la duree reellement mesuree de la boucle d'affichage du mouvement
    (chronometree en temps mur autour du for-loop de flips) a la duree nominale
    attendue (mv_length * frame_ms). Un ecart relatif au-dela de
    TIMING_ANOMALY_THRESHOLD indique un decrochage de cadence (frame(s) perdue(s)
    ou ralentie(s) -- ex: changement de source d'alimentation, charge CPU/GPU
    concurrente). AJOUT PAR RAPPORT A MATLAB (absent de HuxlinLabFBAtraining.m,
    qui ne mesure jamais le rythme reellement obtenu : Screen('Preference',
    'SkipSyncTests',1) l.227, et aucun appel a GetFlipInterval/VBLTimestamp
    n'existe dans ce fichier) -- demande explicitement le 27/08 suite a un
    signal utilisateur de variation de vitesse des points lors d'un changement
    de source d'alimentation. Journalise seulement (non bloquant) pour un essai
    reel ; voir run_performance_check pour l'usage bloquant en debut de seance."""
    nominal_s = mv_length * frame_ms / 1000.0
    if nominal_s <= 0:
        return False
    relative_error = abs(movement_duration_s - nominal_s) / nominal_s
    anomaly = relative_error > TIMING_ANOMALY_THRESHOLD
    if anomaly:
        logger.warning(
            "Anomalie de timing a l'essai %s : duree mouvement mesuree=%.4fs attendue=%.4fs ecart=%.1f%%",
            trial_index, movement_duration_s, nominal_s, 100.0 * relative_error,
        )
    return anomaly


def get_windows_power_status() -> Optional[int]:
    """Interroge l'API Windows GetSystemPowerStatus (kernel32) pour connaitre la
    source d'alimentation actuelle. Retourne la valeur ACLineStatus (0=batterie,
    1=secteur, 255=inconnu), ou None si l'appel echoue ou si la plateforme n'est
    pas Windows (ex: tests, autre OS). AJOUT PAR RAPPORT A MATLAB, absent de
    HuxlinLabFBAtraining.m -- demande explicitement le 27/08 suite a un signal
    utilisateur de branchement/debranchement secteur en cours de seance sur un
    laptop gaming bride sur batterie. Reference officielle :
    learn.microsoft.com/en-us/windows/win32/api/winbase/ns-winbase-system_power_status
    (struct SYSTEM_POWER_STATUS). Comme dans detect_windows_internal_display
    ci-dessus, les champs utilisent des types ctypes a largeur FIXE (c_uint8/
    c_uint32) plutot que ctypes.wintypes, pour la meme raison documentee
    (ctypes.wintypes.DWORD alias C `unsigned long`, dont la taille depend de la
    plateforme de DEVELOPPEMENT et pas seulement de la plateforme cible)."""
    if platform.system() != "Windows":
        return None
    try:
        import ctypes

        class _SystemPowerStatus(ctypes.Structure):
            _fields_ = [
                ("ACLineStatus", ctypes.c_uint8),
                ("BatteryFlag", ctypes.c_uint8),
                ("BatteryLifePercent", ctypes.c_uint8),
                ("SystemStatusFlag", ctypes.c_uint8),
                ("BatteryLifeTime", ctypes.c_uint32),
                ("BatteryFullLifeTime", ctypes.c_uint32),
            ]

        kernel32 = ctypes.windll.kernel32
        kernel32.GetSystemPowerStatus.argtypes = [ctypes.POINTER(_SystemPowerStatus)]
        kernel32.GetSystemPowerStatus.restype = ctypes.c_int32

        status = _SystemPowerStatus()
        ok = kernel32.GetSystemPowerStatus(ctypes.byref(status))
        if not ok:
            return None
        return int(status.ACLineStatus)
    except Exception:
        return None


def check_power_source_change(baseline: Optional[int], logger: logging.Logger) -> bool:
    """Compare la source d'alimentation actuelle a la reference prise au debut
    de la seance reelle (voir run_session). AJOUT PAR RAPPORT A MATLAB, demande
    explicitement le 27/08. DEVIATION ASSUMEE (design confirme par
    l'utilisateur) : simple avertissement journalise (code E11) + note affichee
    sur l'ecran de fin de seance, PAS de popup bloquant en cours d'essai --
    interrompre un essai en cours serait plus perturbant pour un patient
    neurovisuel que le probleme (fluidite degradee) qu'un tel popup
    signalerait. Retourne True si un changement vient d'etre detecte."""
    if baseline is None or baseline == 255:
        return False
    current = get_windows_power_status()
    if current is None or current == 255:
        return False
    if current != baseline:
        logger.warning(
            "[%s] Changement de source d'alimentation detecte en cours de seance (avant=%s apres=%s).",
            ERR_CODE_POWER_SOURCE, baseline, current,
        )
        return True
    return False

# -----------------------------------------------------------------------------
# Boucle d'essais -- orchestration complete d'une seance
# -----------------------------------------------------------------------------
# Structure alignee ecran-par-ecran sur les lignes 364-668 de
# HuxlinLabFBAtraining.m : fixation -> precue (si active) -> ISI compensee ->
# mouvement -> reponse (attente indefinie) -> mise a jour staircase -> essai
# suivant. Les deux pauses "inventees" du draft precedent (1s fixe avant la
# precue, 0.5s fixe apres chaque essai) sont absentes de MATLAB et donc absentes
# ici. Le chronometre de temps de reponse demarre a l'EXTINCTION du stimulus
# (comme le `tic` MATLAB, ligne 581), pas a son apparition.

def run_session(win: "visual.Window", profile: "ScreenProfile", settings: "SessionSettings",
                 logger: logging.Logger) -> SessionOutcome:
    lang = settings.language
    angle_set = settings.angle_set
    ppd = profile.px_per_deg

    n_trials_per_staircase, total_trials = compute_actual_trial_counts(settings.n_trials)
    pause_trial_indices = compute_pause_trial_indices(settings.pause_mode, total_trials)
    calib = compute_calibration_check(profile, settings)

    n_dots = compute_n_dots(APERTURE_RADIUS_DEG, DOT_DENSITY_PER_DEG2)
    radius_px = deg2px(APERTURE_RADIUS_DEG, ppd)
    dot_size_px = max(1.0, math.floor(compute_dot_size_px(ppd)))

    refresh = win.getActualFrameRate(nIdentical=20, nMaxFrames=120, nWarmUpFrames=20)
    if not refresh or refresh <= 0:
        refresh = 60.0
        logger.warning("Frequence de rafraichissement non mesurable, valeur par defaut retenue : 60 Hz.")
    frame_ms = 1000.0 / refresh
    mv_length = max(1, int(round(STIMULUS_DURATION_MS / frame_ms)))
    lifetime_frames = max(1.0, DOT_LIFETIME_MS / frame_ms)  # reste flottant, voir note de fidelite
    step_px = deg2px(DOT_SPEED_DEG_PER_S / refresh, ppd)
    logger.info(
        "Frequence mesuree=%.2f Hz | mv_length=%d frames | lifetime=%.2f frames | ndots=%d | dot_size=%.0f px | "
        "total_essais=%d (%d/staircase) | pauses programmees apres essais %s",
        refresh, mv_length, lifetime_frames, n_dots, dot_size_px, total_trials, n_trials_per_staircase,
        pause_trial_indices,
    )

    fix_pos_px = (deg2px(settings.fixation_h_deg, ppd), deg2px(settings.fixation_v_deg, ppd))
    stim_pos_px = (deg2px(settings.stim_h_deg, ppd), deg2px(settings.stim_v_deg, ppd))

    fixation_outer = visual.Circle(
        win, radius=deg2px(FIX_OUTER_RADIUS_DEG, ppd), fillColor=FIX_OUTER_COLOR_RGB,
        lineColor=FIX_OUTER_COLOR_RGB, pos=fix_pos_px, units="pix",
    )
    fixation_inner = visual.Circle(
        win, radius=deg2px(FIX_INNER_RADIUS_DEG, ppd), fillColor=FIX_INNER_COLOR_RGB,
        lineColor=FIX_INNER_COLOR_RGB, pos=fix_pos_px, units="pix",
    )
    dots = visual.ElementArrayStim(
        win, nElements=n_dots, elementTex=None, elementMask="circle",
        xys=np.zeros((n_dots, 2)), sizes=[dot_size_px] * n_dots, units="pix",
        colors=[DOT_COLOR_RGB] * n_dots, colorSpace="rgb", sfs=0, fieldPos=stim_pos_px,
    )

    def draw_fixation() -> None:
        fixation_outer.draw()
        fixation_inner.draw()

    def build_precue_lines(base_side: int, angle_dev_deg: float) -> Tuple["visual.Line", "visual.Line"]:
        """Reconstruit les deux segments de la precue A CHAQUE appel plutot que
        de reassigner .start/.end sur des objets Line reutilises : certaines
        versions de PsychoPy ne recalculent pas la geometrie affichee quand ces
        attributs sont modifies apres la construction, ce qui rendait la precue
        invisible (segments restes a leur position de creation (0,0)->(0,0))."""
        (dx1, dy1), (dx2, dy2) = compute_precue_geometry(base_side, angle_dev_deg, profile.width_px)
        line1 = visual.Line(
            win, start=fix_pos_px, end=(fix_pos_px[0] + dx1, fix_pos_px[1] + dy1),
            lineColor=CUE_COLOR_RGB, lineWidth=3, units="pix",
        )
        line2 = visual.Line(
            win, start=fix_pos_px, end=(fix_pos_px[0] + dx2, fix_pos_px[1] + dy2),
            lineColor=CUE_COLOR_RGB, lineWidth=3, units="pix",
        )
        return line1, line2

    sounds = build_session_sounds(logger)
    stair_idxs = INITIAL_STAIR_IDXS.copy()
    streak_counts = [0, 0, 0]
    stair_sequence = build_stair_sequence(n_trials_per_staircase)

    outcome = SessionOutcome(total_trials_planned=total_trials, frame_rate_measured=float(refresh), calibration_check=calib)
    rt_clock = core.Clock()

    def run_one_trial(base_side: int, tilt_sign: int, angle_dev_deg: float,
                       display_trial_index: int, display_total_trials: int) -> TrialRunResult:
        """Sequence complete d'un essai unique : precue (si activee) -> ISI
        compensee -> son de depart -> mouvement -> extinction -> attente de
        reponse (avec gestion Echap = pause/reprise). Extrait de la boucle
        d'essais (auparavant inline) le 27/08 pour etre reutilisee A
        L'IDENTIQUE par la vraie sequence d'essais ET par run_performance_check
        (essais d'echauffement) -- garantit que les essais d'echauffement sont
        visuellement et temporellement indiscernables d'un vrai essai pour le
        patient, comme demande explicitement ("silencieux")."""
        td = compute_trial_direction(angle_set, base_side, tilt_sign, angle_dev_deg)

        # --- Precue (si activee) : chevron, visible cue_duration secondes ---
        if settings.show_precue:
            cue_line1, cue_line2 = build_precue_lines(base_side, angle_dev_deg)
            cue_line1.draw()
            cue_line2.draw()
            draw_fixation()
            win.flip()
            core.wait(CUE_DURATION_S)

        # --- Retrait de la precue, demarrage de l'ISI compensee (l.503-554) ---
        draw_fixation()
        win.flip()
        t_cue_off = core.getTime()

        frames = precompute_trial_frames(n_dots, radius_px, lifetime_frames, td.vx, td.vy, step_px, mv_length)

        elapsed = core.getTime() - t_cue_off
        remaining = POST_CUE_ISI_S - elapsed
        if remaining > 0:
            core.wait(remaining)

        # --- Elevation de priorite OS pendant [son de depart + mouvement], cf.
        # Priority(MaxPriority(w)) MATLAB l.555-556 (juste avant le son de
        # depart) / Priority(0) l.582 (juste apres le dernier flip du
        # mouvement) -- AJOUT PAR RAPPORT AU PYTHON PRECEDENT (core.rush()
        # absent depuis le tout premier brouillon), demande explicitement le
        # 27/08 suite a un signal utilisateur de variation de vitesse des
        # points lors d'un changement de source d'alimentation. Cf.
        # psychopy.org/api/core.html et discourse.psychopy.org (core.rush est
        # l'equivalent documente, multi-plateforme, de Priority() : no-op
        # silencieux la ou l'OS ne supporte pas l'elevation de priorite).
        core.rush(True)
        _play(sounds.get("start"), logger)
        core.wait(POST_START_SOUND_GAP_S)

        # --- Mouvement (frame 1 = position initiale statique, l.510-517) ---
        win.callOnFlip(event.clearEvents, eventType="keyboard")
        t_movement_start = core.getTime()
        for frame_positions in frames:
            dots.xys = frame_positions
            dots.draw()
            draw_fixation()
            win.flip()
        movement_duration_s = core.getTime() - t_movement_start

        # --- Extinction du stimulus ; le chrono de RT demarre ICI (l.578-581) ---
        draw_fixation()
        win.flip()
        core.rush(False)

        event.clearEvents(eventType="keyboard")
        rt_clock.reset()

        timing_anomaly = check_movement_timing(movement_duration_s, mv_length, frame_ms, logger, display_trial_index)

        # --- Attente de reponse, indefinie, avec gestion Echap = pause/reprise ---
        quit_requested = False
        key_pressed = ""
        rt_s = float("nan")
        trial_paused_s = 0.0
        while True:
            keys = event.waitKeys(keyList=[td.correct_key, td.incorrect_key, "escape"], timeStamped=rt_clock)
            key_pressed, rt_s = keys[0]
            if key_pressed == "escape":
                t_pause_start = core.getTime()
                if show_escape_pause_screen(win, lang, display_trial_index, display_total_trials):
                    quit_requested = True
                    break
                pause_elapsed = core.getTime() - t_pause_start
                trial_paused_s += pause_elapsed
                draw_fixation()
                win.flip()
                continue
            break

        if quit_requested:
            return TrialRunResult(
                quit_requested=True, key_pressed="", rt_s=float("nan"), correct=False,
                angle_deg=float(td.angle_deg), correct_key=td.correct_key,
                trial_paused_s=trial_paused_s, movement_duration_s=movement_duration_s,
                timing_anomaly=timing_anomaly,
            )

        # Retranche le temps de pause Echap (voir DEVIATION ASSUMEE plus bas) : rt_s tel que
        # renvoye par event.waitKeys(timeStamped=rt_clock) inclut sinon integralement la duree
        # de l'ecran de pause, puisque rt_clock n'est jamais mis en pause lui-meme.
        rt_s = max(0.0, rt_s - trial_paused_s)
        correct = key_pressed == td.correct_key
        _play(sounds.get("correct") if correct else sounds.get("incorrect"), logger)

        return TrialRunResult(
            quit_requested=False, key_pressed=key_pressed, rt_s=float(rt_s), correct=correct,
            angle_deg=float(td.angle_deg), correct_key=td.correct_key,
            trial_paused_s=trial_paused_s, movement_duration_s=movement_duration_s,
            timing_anomaly=timing_anomaly,
        )

    def run_performance_check() -> Tuple[str, str]:
        """Phase de verification initiale (NOUVEAU, absent de MATLAB) : fait
        tourner PERF_CHECK_N_TRIALS essais visuellement et temporellement
        identiques a de vrais essais (meme stimulus, meme sequence d'ecrans,
        reponse du patient attendue et traitee normalement, meme angle facile
        pour ne pas tester le patient) via run_one_trial, MAIS dont les
        resultats ne sont ni comptabilises dans les staircases ni enregistres
        dans le CSV -- ils servent uniquement a mesurer le rythme d'affichage
        reellement obtenu sur cette machine, a ce moment precis, avant de
        lancer la vraie sequence. AJOUT PAR RAPPORT A MATLAB, demande
        explicitement le 27/08 en reponse a un signal utilisateur de variation
        de vitesse des points lors d'un changement de source d'alimentation sur
        un laptop gaming bride sur batterie. Design confirme par l'utilisateur :
        phase silencieuse (indiscernable d'un vrai essai pour le patient) et
        BLOQUANTE en cas d'anomalie (la seance ne demarre pas). Retourne
        (statut, detail) avec statut in {'ok', 'quit', 'anomaly'}."""
        n_anomalies = 0
        for _ in range(PERF_CHECK_N_TRIALS):
            draw_fixation()
            win.flip()
            base_side = int(np.random.randint(1, 3))
            tilt_sign = int(np.random.choice([-1, 1]))
            result = run_one_trial(base_side, tilt_sign, PERF_CHECK_ANGLE_DEV_DEG, 1, total_trials)
            if result.quit_requested:
                return "quit", ""
            if result.timing_anomaly:
                n_anomalies += 1
            draw_fixation()
            win.flip()
        if n_anomalies > 0:
            detail = f"{n_anomalies}/{PERF_CHECK_N_TRIALS} essai(s) d'echauffement en anomalie de timing"
            logger.error("[%s] Verification initiale de performance echouee : %s", ERR_CODE_PERF_CHECK, detail)
            return "anomaly", detail
        logger.info("Verification initiale de performance : OK (%d essais, aucune anomalie).", PERF_CHECK_N_TRIALS)
        return "ok", ""

    draw_fixation()
    win.flip()

    perf_status, perf_detail = run_performance_check()
    if perf_status == "quit":
        outcome.aborted = True
        outcome.final_stair_idxs = stair_idxs
        logger.info("Arret demande par l'utilisateur (Echap) pendant la verification initiale de performance.")
        return outcome
    if perf_status == "anomaly":
        outcome.perf_check_failed = True
        outcome.error = f"[{ERR_CODE_PERF_CHECK}] {perf_detail}"
        outcome.final_stair_idxs = stair_idxs
        return outcome

    # session_clock demarre ICI, APRES la verification initiale : sa duree n'est
    # jamais incluse dans outcome.total_time_s (coherent avec le fait que ces
    # essais ne sont pas des essais reels). power_source_baseline est capture au
    # meme moment, comme reference pour check_power_source_change pendant la
    # vraie seance -- AJOUTS PAR RAPPORT A MATLAB, voir plus haut.
    session_clock = core.Clock()
    power_source_baseline = get_windows_power_status()
    # DEVIATION ASSUMEE (demandee explicitement le 27/08, apres confirmation que MATLAB, lui,
    # NE bloque le chrono ni pour une pause Echap ni pour une pause programmee -- le temps de
    # pause y reste inclus a la fois dans le temps de reaction et dans totalTime). Ici, le temps
    # passe en pause (Echap pendant l'attente de reponse, OU pause programmee entre deux essais)
    # est retranche a la fois du temps de reaction (rt_s, par essai) et de la duree totale de
    # seance (outcome.total_time_s). total_paused_s cumule les deux types de pause sur toute la
    # seance ; voir son usage plus bas.
    total_paused_s = 0.0

    draw_fixation()
    win.flip()

    try:
        for trial_index, which_stair in enumerate(stair_sequence, start=1):
            # --- Ecran de fixation seule (haut de boucle MATLAB, l.370-372) ---
            # NOTE : le compteur d'essais a l'ecran (present dans MATLAB) a ete
            # retire de l'affichage a la demande de l'utilisateur ; le numero
            # d'essai reste enregistre dans les logs et le CSV de sortie.
            draw_fixation()
            win.flip()

            # --- Selection direction/orientation/difficulte (instantane) ---
            maybe_advance_staircase(stair_idxs, streak_counts, which_stair, len(ANGLE_RANGE_DEG))
            angle_dev_deg = ANGLE_RANGE_DEG[stair_idxs[which_stair - 1]]
            base_side = int(np.random.randint(1, 3))
            tilt_sign = int(np.random.choice([-1, 1]))

            result = run_one_trial(base_side, tilt_sign, angle_dev_deg, trial_index, total_trials)

            if result.quit_requested:
                outcome.aborted = True
                logger.info("Arret demande par l'utilisateur (Echap) a l'essai %d/%d.", trial_index, total_trials)
                break

            total_paused_s += result.trial_paused_s
            record_staircase_response(stair_idxs, streak_counts, which_stair, result.correct, len(ANGLE_RANGE_DEG))

            if not outcome.power_source_changed:
                outcome.power_source_changed = check_power_source_change(power_source_baseline, logger)

            outcome.trials.append(TrialRecord(
                trial=trial_index, staircase_id=which_stair, angle_dev_deg=float(angle_dev_deg),
                base_side=base_side, tilt_sign=tilt_sign, angle_deg=result.angle_deg,
                correct_key=result.correct_key, key_pressed=result.key_pressed,
                is_correct=int(result.correct), rt_s=result.rt_s,
                timing_anomaly=int(result.timing_anomaly),
            ))
            logger.debug(
                "Essai %d/%d staircase=%d dev=%.2f base_side=%d tilt=%+d correct_key=%s touche=%s rt=%.3f "
                "correct=%d anomalie_timing=%d",
                trial_index, total_trials, which_stair, angle_dev_deg, base_side, tilt_sign,
                result.correct_key, result.key_pressed, result.rt_s, int(result.correct),
                int(result.timing_anomaly),
            )

            draw_fixation()
            win.flip()

            if trial_index in pause_trial_indices:
                logger.info("Pause programmee apres l'essai %d/%d.", trial_index, total_trials)
                t_pause_start = core.getTime()
                if do_scheduled_pause(win, sounds, lang, trial_index, total_trials, logger):
                    outcome.aborted = True
                    logger.info("Arret demande par l'utilisateur (Echap pendant une pause programmee).")
                    break
                # Voir DEVIATION ASSUMEE plus haut : la duree de la pause programmee (jusqu'a
                # SCHEDULED_PAUSE_DURATION_S, plus toute pause Echap imbriquee a l'interieur) est
                # elle aussi retranchee de la duree totale de seance.
                total_paused_s += core.getTime() - t_pause_start
                draw_fixation()
                win.flip()

    except Exception as exc:  # pragma: no cover - filet de securite, voir log_uncaught_exception
        outcome.error = repr(exc)
        logger.error("Exception pendant la seance : %s", exc)
        log_uncaught_exception(logger, exc)

    outcome.total_time_s = max(0.0, session_clock.getTime() - total_paused_s)
    outcome.final_stair_idxs = stair_idxs
    return outcome

