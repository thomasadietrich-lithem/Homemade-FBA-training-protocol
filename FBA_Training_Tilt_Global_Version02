def next_session_number(subject_id: str, logger: Optional[logging.Logger] = None) -> int:
    """Incremente et persiste immediatement le compteur de seances du patient.
    Appele uniquement une fois la seance definitivement confirmee (apres l'ecran
    recapitulatif), pour qu'un setup abandonne ne consomme pas de numero."""
    counters = _load_json(COUNTERS_FILE)
    n = int(counters.get(subject_id, 0)) + 1
    counters[subject_id] = n
    _save_json(COUNTERS_FILE, counters, logger)
    return n


def build_output_basename(subject_id: str, session_num: int, timestamp: _dt.datetime) -> str:
    """Nom de fichier lisible : SUJET_seanceNNN_AAAAMMJJ-HHMMSS (sans espace, sans
    caractere special, trie chronologiquement et par sujet dans un dossier)."""
    ts = timestamp.strftime("%Y%m%d-%H%M%S")
    safe_id = "".join(c for c in subject_id if c.isalnum() or c in ("-", "_")) or DEFAULT_SUBJECT_ID
    return f"{safe_id}_seance{session_num:03d}_{ts}"


