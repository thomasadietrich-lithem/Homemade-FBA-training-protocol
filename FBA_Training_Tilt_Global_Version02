def t(key: str, lang: str, **kwargs) -> str:
    """Translation helper. Raises loudly if a key is missing, rather than
    silently falling back, so translation gaps are caught during testing
    rather than discovered by a patient mid-session."""
    try:
        template = TR[lang][key]
    except KeyError as exc:
        raise KeyError(f"Missing translation for key={key!r} lang={lang!r}") from exc
    return template.format(**kwargs) if kwargs else template


def translations_are_complete() -> bool:
    """Self-check: every key present in one language must be present in all others."""
    all_keys = set()
    for lang_dict in TR.values():
        all_keys |= set(lang_dict.keys())
    ok = True
    for lang, lang_dict in TR.items():
        missing = all_keys - set(lang_dict.keys())
        if missing:
            ok = False
    return ok

