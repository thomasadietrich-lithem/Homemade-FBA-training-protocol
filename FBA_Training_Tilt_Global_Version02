def compute_rt_statistics(trials: List["TrialRecord"]) -> dict:
    """AJOUT PAR RAPPORT AU PYTHON PRECEDENT (27/08, round 3) : statistiques
    agregees de temps de reponse, absentes du JSON de sortie jusqu'ici --
    recommande par l'audit V4 (S7.3, S13.3). Purement descriptif (n'influence
    ni le staircase ni le deroulement de la seance ; ajoute uniquement au
    resume pour le clinicien/l'aidant). Calcule sur outcome.trials, qui
    n'inclut jamais un essai interrompu par Echap (voir run_session : le
    "break" sur result.quit_requested a lieu AVANT l'ajout du TrialRecord),
    donc jamais de rt_s NaN ici. Retourne la moyenne/mediane globales, plus le
    detail par staircase (moyenne/mediane/ecart-type -- ce dernier necessite
    au moins 2 essais sur cette staircase, sinon 0.0)."""
    global_rts = [r.rt_s for r in trials]
    par_staircase: Dict[str, dict] = {}
    for stair_id in sorted({r.staircase_id for r in trials}):
        stair_rts = [r.rt_s for r in trials if r.staircase_id == stair_id]
        par_staircase[str(stair_id)] = {
            "n": len(stair_rts),
            "moyenne_s": statistics.mean(stair_rts) if stair_rts else None,
            "mediane_s": statistics.median(stair_rts) if stair_rts else None,
            "ecart_type_s": statistics.stdev(stair_rts) if len(stair_rts) >= 2 else 0.0,
        }
    return {
        "global": {
            "n": len(global_rts),
            "moyenne_s": statistics.mean(global_rts) if global_rts else None,
            "mediane_s": statistics.median(global_rts) if global_rts else None,
        },
        "par_staircase": par_staircase,
    }


def _write_session_outputs_to_dir(data_dir: str, settings: "SessionSettings", profile: "ScreenProfile",
                                   outcome: SessionOutcome, session_num: int,
                                   timestamp: _dt.datetime) -> Tuple[str, str]:
    """Ecrit effectivement le CSV essai-par-essai et le resume JSON dans
    data_dir. Peut lever une exception (OSError typiquement : disque plein,
    droits d'acces refuses, chemin invalide) -- voir write_session_outputs pour
    la gestion de cet echec (bascule vers un repertoire de secours)."""
    os.makedirs(data_dir, exist_ok=True)
    basename = build_output_basename(settings.subject_id, session_num, timestamp)
    csv_path = os.path.join(data_dir, basename + "_essais.csv")
    json_path = os.path.join(data_dir, basename + "_resume.json")

    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow([
            "essai", "staircase_id", "angle_deviation_deg", "cote_base", "signe_inclinaison",
            "angle_absolu_deg", "touche_correcte", "touche_pressee", "reponse_correcte", "temps_reponse_s",
            "anomalie_timing",
        ])
        for r in outcome.trials:
            writer.writerow([
                r.trial, r.staircase_id, r.angle_dev_deg, r.base_side, r.tilt_sign,
                r.angle_deg, r.correct_key, r.key_pressed, r.is_correct, r.rt_s, r.timing_anomaly,
            ])

    summary = {
        "logiciel": SOFTWARE_NAME,
        "version_logiciel": SOFTWARE_VERSION,
        "horodatage": timestamp.isoformat(timespec="seconds"),
        "numero_seance": session_num,
        "sujet": settings.subject_id,
        "langue": settings.language,
        "duree_totale_s": outcome.total_time_s,
        "essais_completes": outcome.n_completed,
        "essais_prevus": outcome.total_trials_planned,
        "essais_corrects": outcome.n_correct,
        "precision_pourcent": outcome.accuracy_percent,
        "seuil_final_moyen_deg": outcome.final_threshold_deg,
        "seuils_finaux_par_staircase_deg": (
            [ANGLE_RANGE_DEG[i] for i in outcome.final_stair_idxs] if outcome.final_stair_idxs else []
        ),
        "interrompue": outcome.aborted,
        "erreur": outcome.error,
        "verification_initiale_perf_echouee": outcome.perf_check_failed,
        "changement_alimentation_detecte": outcome.power_source_changed,
        "essais_avec_anomalie_timing": sum(r.timing_anomaly for r in outcome.trials),
        "statistiques_temps_reponse": compute_rt_statistics(outcome.trials),
        "position": {
            "axe_reponse": settings.axis_mode,
            "fixation_h_deg": settings.fixation_h_deg,
            "fixation_v_deg": settings.fixation_v_deg,
            "stimulus_h_deg": settings.stim_h_deg,
            "stimulus_v_deg": settings.stim_v_deg,
        },
        "protocole": {
            "n_staircases": N_STAIRCASES,
            "echelle_angles_deg": ANGLE_RANGE_DEG,
            "densite_points_par_deg2": DOT_DENSITY_PER_DEG2,
            "vitesse_points_deg_s": DOT_SPEED_DEG_PER_S,
            "rayon_aperture_deg": APERTURE_RADIUS_DEG,
            "duree_stimulus_ms": STIMULUS_DURATION_MS,
            "duree_vie_points_ms": DOT_LIFETIME_MS,
            "duree_precue_s": CUE_DURATION_S,
            "isi_post_precue_s": POST_CUE_ISI_S,
            "precue_activee": settings.show_precue,
            "style_precue": "chevron_deux_segments",
            "mode_correspondance_touche": "deduite_geometriquement_du_vecteur_affiche",
        },
        "ecran": {
            "index": profile.screen_index,
            "resolution_px": [profile.width_px, profile.height_px],
            "diagonale_pouces": profile.diagonal_in,
            "largeur_cm": profile.width_cm,
            "distance_visionnage_cm": profile.viewing_distance_cm,
            "px_par_degre": profile.px_per_deg,
            "taille_point_px": profile.dot_size_px,
            "frequence_rafraichissement_mesuree_hz": outcome.frame_rate_measured,
        },
        "verification_physique": outcome.calibration_check,
        "pauses_programmees": settings.pause_mode,
        "fichier_essais_csv": os.path.basename(csv_path),
    }
    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(summary, f, indent=2, ensure_ascii=False)

    return csv_path, json_path


def write_session_outputs(settings: "SessionSettings", profile: "ScreenProfile", outcome: SessionOutcome,
                           session_num: int, timestamp: _dt.datetime,
                           logger: logging.Logger) -> Tuple[Optional[str], Optional[str], str]:
    """Enregistre les resultats de la seance (CSV essai-par-essai + resume
    JSON). AJOUT PAR RAPPORT AU PYTHON PRECEDENT (27/08, code E12) : la version
    precedente appelait l'ecriture des fichiers sans aucune gestion
    d'exception -- une erreur disque (espace insuffisant, droits refuses)
    SURVENANT APRES UNE SEANCE COMPLETE faisait perdre definitivement les
    resultats, sans le moindre message a l'ecran. Ici, un premier echec
    bascule automatiquement vers un repertoire de secours (dossier temporaire
    du systeme) ; si ce secours echoue aussi, l'appelant (main) doit en
    informer le patient/l'aidant. Retourne (csv_path, json_path, statut) avec
    statut in {'ok', 'secours', 'echec'} -- csv_path/json_path valent None
    uniquement si statut == 'echec'."""
    primary_dir = os.path.join(BASE_DIR, DATA_DIRNAME)
    try:
        csv_path, json_path = _write_session_outputs_to_dir(primary_dir, settings, profile, outcome, session_num, timestamp)
        logger.info("Resultats enregistres : %s / %s", csv_path, json_path)
        return csv_path, json_path, "ok"
    except Exception as exc:
        logger.error("[%s] Echec de sauvegarde des resultats dans %s : %s", ERR_CODE_SAVE_FAILURE, primary_dir, exc)

    fallback_dir = os.path.join(tempfile.gettempdir(), DATA_DIRNAME)
    try:
        csv_path, json_path = _write_session_outputs_to_dir(fallback_dir, settings, profile, outcome, session_num, timestamp)
        logger.warning("[%s] Sauvegarde de secours reussie : %s / %s", ERR_CODE_SAVE_FAILURE, csv_path, json_path)
        return csv_path, json_path, "secours"
    except Exception as exc:
        logger.error("[%s] Echec de la sauvegarde de secours egalement : %s", ERR_CODE_SAVE_FAILURE, exc)
        return None, None, "echec"


def run_calibration_check_screen(win: "visual.Window", profile: "ScreenProfile", settings: "SessionSettings",
                                  calib: Dict[str, float], lang: str) -> str:
    """Reproduit l'ecran de verification physique de HuxlinLabFBAtraining.m
    (lignes 337-361 : test_rect2/test_size/test_size2) -- dessine, a
    l'echelle reelle, un carre blanc (diametre = ouverture de l'aperture RDK,
    a la position du stimulus) et un trait entre la croix de fixation et ce
    carre, avec leur taille annoncee pour verification a la regle. MATLAB
    n'annonce que des pouces ; le cm est ajoute ici (affichage uniquement,
    aucune valeur scientifique n'en depend) car le public est francophone.

    AJOUT PAR RAPPORT A MATLAB (demande explicitement le 27/08) : MATLAB
    affiche ces mesures puis attend une touche QUELCONQUE pour continuer,
    sans jamais demander confirmation ni offrir de correction -- purement
    informatif, sans porte de sortie. Ici, une confirmation explicite est
    demandee : ESPACE = correspond, on continue (comme partout ailleurs dans
    ce script) ; RETOUR ARRIERE = ne correspond pas, on retourne CORRIGER LA
    CALIBRATION -- en rouvrant EXACTEMENT le meme formulaire que
    run_setup_wizard (_ask_full_settings), jamais un second point de saisie
    independant ; ECHAP = quitter la seance (comme partout ailleurs).
    Retourne 'confirmed', 'correct', ou 'quit'."""
    ppd = profile.px_per_deg
    fix_pos_px = (deg2px(settings.fixation_h_deg, ppd), deg2px(settings.fixation_v_deg, ppd))
    stim_pos_px = (deg2px(settings.stim_h_deg, ppd), deg2px(settings.stim_v_deg, ppd))
    box_side_px = 2.0 * deg2px(APERTURE_RADIUS_DEG, ppd)

    box = visual.Rect(
        win, size=(box_side_px, box_side_px), pos=stim_pos_px,
        fillColor=1.0, lineColor=None, colorSpace="rgb", units="pix",
    )
    line = visual.Line(
        win, start=fix_pos_px, end=stim_pos_px, lineColor=TEXT_COLOR_RGB, lineWidth=2, units="pix",
    )
    fixation_outer = visual.Circle(
        win, radius=deg2px(FIX_OUTER_RADIUS_DEG, ppd), fillColor=FIX_OUTER_COLOR_RGB,
        lineColor=FIX_OUTER_COLOR_RGB, pos=fix_pos_px, units="pix",
    )
    fixation_inner = visual.Circle(
        win, radius=deg2px(FIX_INNER_RADIUS_DEG, ppd), fillColor=FIX_INNER_COLOR_RGB,
        lineColor=FIX_INNER_COLOR_RGB, pos=fix_pos_px, units="pix",
    )
    # Bloc de texte ancre en HAUT d'ecran a position fixe -- comme les
    # `Screen('DrawText', w, ..., 100, 130..250, 0)` de MATLAB, qui placent
    # deliberement ce texte dans une zone fixe independante de la geometrie
    # (variable) fixation/stimulus, pour ne jamais se superposer au carre/trait.
    label = visual.TextStim(
        win, text=t("calib_check_body", lang, box_cm=calib["box_cm"], box_in=calib["box_in"],
                     line_cm=calib["line_cm"], line_in=calib["line_in"]),
        color=TEXT_COLOR_RGB, height=22, wrapWidth=profile.width_px * 0.8, units="pix",
        pos=(0, profile.height_px / 2.0 - 40), anchorHoriz="center", anchorVert="top", alignText="center",
    )

    box.draw()
    line.draw()
    fixation_outer.draw()
    fixation_inner.draw()
    label.draw()
    win.flip()
    keys = event.waitKeys(keyList=["space", "backspace", "escape"])
    key = keys[0] if keys else "escape"
    if key == "space":
        return "confirmed"
    if key == "backspace":
        return "correct"
    return "quit"


def build_readme_stims(win: "visual.Window", wrap_width_px: float, intro_text: str,
                        disclaimer_text: str, details_text: str) -> List["visual.TextStim"]:
    """Construit les 3 blocs de texte empiles de l'ecran pre-lancement (intro
    neutre / disclaimer sante EN ROUGE -- demande explicitement le 27/08 /
    details de la seance), en mesurant la hauteur REELLE de chaque bloc via
    TextStim.boundingBox -- propriete officiellement documentee comme
    toujours exprimee en pixels quelles que soient les unites du stim (voir
    docs.psychopy.org/api/visual/textstim.html) -- plutot que de supposer une
    hauteur de ligne fixe (fragile : depend de la police, du nombre de lignes
    apres retour a la ligne automatique, etc.). Les 3 blocs restent centres
    horizontalement (anchorHoriz='center', comme l'unique bloc precedent) et
    sont ancres par leur bord SUPERIEUR (anchorVert='top') pour permettre
    l'empilement ; le groupe entier est ensuite recentre verticalement autour
    de y=0 pour reproduire la position centrale du bloc unique d'origine."""
    blocks = [
        (intro_text, TEXT_COLOR_RGB),
        (disclaimer_text, DISCLAIMER_COLOR_RGB),
        (details_text, TEXT_COLOR_RGB),
    ]
    stims: List["visual.TextStim"] = []
    heights: List[float] = []
    for text, color in blocks:
        stim = visual.TextStim(
            win, text=text, color=color, height=22, wrapWidth=wrap_width_px, units="pix",
            pos=(0, 0), anchorHoriz="center", anchorVert="top", alignText="center",
        )
        stims.append(stim)
        heights.append(float(stim.boundingBox[1]))

    total_height = sum(heights) + README_BLOCK_GAP_PX * (len(stims) - 1)
    y = total_height / 2.0
    for stim, h in zip(stims, heights):
        stim.pos = (0, y)
        y -= (h + README_BLOCK_GAP_PX)
    return stims

