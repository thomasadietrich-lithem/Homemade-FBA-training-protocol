    }
    function drawLine(ctx, x1,y1,x2,y2){ ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke(); }
    function safeAnchor(loc){ return loc.replace(/[^A-Za-z0-9_-]+/g, '_'); }
    function checked(id) { const el = document.getElementById(id); return el ? el.checked : false; }

    function selectedIndexes(anchor) {
      return Array.from(document.querySelectorAll('.cmp-' + CSS.escape(anchor))).filter(x => x.checked && !x.disabled).map(x => parseInt(x.value));
    }
    function selectedColor(anchor, index, fallback) {
      const el = document.querySelector('.color-' + CSS.escape(anchor) + '[data-index="' + index + '"]');
      return el ? el.value : fallback;
    }
    function selectComparison(anchor, mode) {
      const boxes = Array.from(document.querySelectorAll('.cmp-' + CSS.escape(anchor))).filter(x => !x.disabled);
      boxes.forEach(b => b.checked = false);
      if (mode === 'recent') boxes.slice(-5).forEach(b => b.checked = true);
      if (mode === 'firstlast' && boxes.length) { boxes[0].checked = true; boxes[boxes.length-1].checked = true; }
    }

    function renderLongitudinal(locationId, anchor) {
      const sessions = (DASHBOARD_DATA.locations[locationId] || []).filter(s => s.timestamp != null);
      const canvas = document.getElementById('long_canvas_' + anchor);
      const note = document.getElementById('long_note_' + anchor);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0,0,canvas.width,canvas.height);
      ctx.font = '13px Arial';
      const W = canvas.width, H = canvas.height;
      const m = {l:65, r:65, t:35, b:75};
      if (!sessions.length) { ctx.fillText('No longitudinal data.', m.l, m.t); return; }
      const thr = sessions.map(s => (s.fit_valid && s.threshold_deg != null) ? Number(s.threshold_deg) : NaN);
      const acc = sessions.map(s => s.accuracy_percent != null ? Number(s.accuracy_percent) : NaN);
      const pooled = sessions.map(s => s.pooled_3session_threshold_deg != null ? Number(s.pooled_3session_threshold_deg) : NaN);
      const thrMA5 = movingAverage(thr, 5);
      const thrMA10 = movingAverage(thr, 10);
      const accMA5 = movingAverage(acc, 5);
      const showRaw = checked('raw_' + anchor);
      const showMA5 = checked('ma5_' + anchor);
      const showMA10 = checked('ma10_' + anchor);
      const showPooled = checked('pooled_' + anchor);

      const maxThr = Math.max(...thr.concat(pooled, thrMA5, thrMA10).filter(Number.isFinite), 10);
      const yThrMax = Math.max(10, Math.ceil(maxThr / 10) * 10);
      function X(i){ return m.l + (i - 1) / Math.max(1, sessions.length - 1) * (W - m.l - m.r); }
      function Ythr(v){ return H - m.b - (v / yThrMax) * (H - m.t - m.b); }
      function Yacc(v){ return H - m.b - (v / 100) * (H - m.t - m.b); }

      ctx.strokeStyle = '#333'; ctx.lineWidth = 1;
      drawLine(ctx, m.l, H-m.b, W-m.r, H-m.b);
      drawLine(ctx, m.l, m.t, m.l, H-m.b);
      drawLine(ctx, W-m.r, m.t, W-m.r, H-m.b);
      ctx.fillStyle = '#333';
      for (let y=0; y<=yThrMax; y+=Math.max(10, yThrMax/5)) {
        const yy = Ythr(y);
        ctx.strokeStyle = '#eee'; drawLine(ctx, m.l, yy, W-m.r, yy);
        ctx.fillStyle = '#333'; ctx.fillText(String(Math.round(y)), 18, yy+4);
      }
      for (let y=0; y<=100; y+=20) {
        const yy = Yacc(y);
        ctx.fillStyle = '#666'; ctx.fillText(String(y), W-m.r+10, yy+4);
      }
      const step = Math.max(1, Math.ceil(sessions.length / 12));
      for (let i=1; i<=sessions.length; i+=step) {
        const xx = X(i);
        ctx.strokeStyle = '#ddd'; drawLine(ctx, xx, H-m.b, xx, H-m.b+5);
        ctx.save(); ctx.translate(xx-8, H-m.b+12); ctx.rotate(-Math.PI/4);
        ctx.fillStyle = '#333'; ctx.fillText('S' + i, 0, 0); ctx.restore();
      }
      ctx.fillStyle = '#333';
      ctx.fillText('threshold (deg; lower is better)', 8, 20);
      ctx.fillText('accuracy (%)', W-m.r-20, 20);

      function plotSeries(vals, color, yfn, dash, width, marker) {
        ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = width || 2;
        ctx.setLineDash(dash || []);
        let started = false; ctx.beginPath();
        vals.forEach((v, idx) => {
          if (!Number.isFinite(v)) { started = false; return; }
          const xx = X(idx+1), yy = yfn(v);
          if (!started) { ctx.moveTo(xx, yy); started = true; } else ctx.lineTo(xx, yy);
        });
        ctx.stroke(); ctx.setLineDash([]);
        if (marker) {
          vals.forEach((v, idx) => {
            if (!Number.isFinite(v)) return;
            ctx.beginPath(); ctx.arc(X(idx+1), yfn(v), 3, 0, Math.PI*2); ctx.fill();
          });
        }
      }
      if (showRaw) {
        plotSeries(thr, '#1f77b4', Ythr, [], 1.6, true);
        plotSeries(acc, '#d62728', Yacc, [], 1.3, true);
      }
      if (showMA5) {
        plotSeries(thrMA5, '#003f8c', Ythr, [7,4], 2.0, false);
        plotSeries(accMA5, '#8c1f13', Yacc, [7,4], 2.0, false);
      }
      if (showMA10) {
        plotSeries(thrMA10, '#6baed6', Ythr, [2,4], 2.0, false);
      }
      if (showPooled) {
        plotSeries(pooled, '#2ca02c', Ythr, [1,3], 2.4, false);
      }

      let legend = [];
      if (showRaw) legend.push(['#1f77b4','raw threshold'], ['#d62728','raw accuracy']);
      if (showMA5) legend.push(['#003f8c','MA5 threshold'], ['#8c1f13','MA5 accuracy']);
      if (showMA10) legend.push(['#6baed6','MA10 threshold']);
      if (showPooled) legend.push(['#2ca02c','3-session pooled threshold']);
      legend.forEach((item, idx) => {
        ctx.fillStyle = item[0]; ctx.fillRect(m.l + 10, m.t + 8 + idx*18, 12, 12);
        ctx.fillStyle = '#333'; ctx.fillText(item[1], m.l + 28, m.t + 19 + idx*18);
      });
      const finiteThr = thr.filter(Number.isFinite);
      const finiteAcc = acc.filter(Number.isFinite);
      const meanThr = finiteThr.length ? finiteThr.reduce((a,b)=>a+b,0)/finiteThr.length : NaN;
      const meanAcc = finiteAcc.length ? finiteAcc.reduce((a,b)=>a+b,0)/finiteAcc.length : NaN;
      const sdThr = finiteThr.length ? Math.sqrt(finiteThr.map(v => Math.pow(v - meanThr, 2)).reduce((a,b)=>a+b,0)/finiteThr.length) : NaN;
      const sdAcc = finiteAcc.length ? Math.sqrt(finiteAcc.map(v => Math.pow(v - meanAcc, 2)).reduce((a,b)=>a+b,0)/finiteAcc.length) : NaN;
      if(note) note.textContent = `Sessions: ${sessions.length}. SD threshold: ${Number.isFinite(sdThr) ? sdThr.toFixed(2) + '°' : 'n/a'}; SD accuracy: ${Number.isFinite(sdAcc) ? sdAcc.toFixed(2) + '%' : 'n/a'}. Raw data remain visible when the raw-data box is selected.`;
    }

    function renderComparison(locationId, anchor) {
      const sessions = DASHBOARD_DATA.locations[locationId] || [];
      const selected = selectedIndexes(anchor).map(i => sessions[i]).filter(s => s && s.fit_valid && s.alpha_log != null && s.beta != null);
      const canvas = document.getElementById('canvas_' + anchor);
      const note = document.getElementById('cmp_note_' + anchor);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0,0,canvas.width,canvas.height);
      ctx.font = '13px Arial';
      const W = canvas.width, H = canvas.height;
      const m = {l:70, r:25, t:35, b:70};
      if (!selected.length) { ctx.fillText('Select one or more valid sessions.', m.l, m.t); if(note) note.textContent=''; return; }
      let xVals = [];
      selected.forEach(s => (s.percent_correct_table || []).forEach(p => xVals.push(log10((p.angle_deg || 0) + 1))));
      if (!xVals.length) { xVals = [0, 2]; }
      let xmin = Math.min(...xVals), xmax = Math.max(...xVals);
      xmin = Math.max(0, xmin - 0.03); xmax = xmax + 0.03;
      if (xmax <= xmin) xmax = xmin + 1;
      function X(x){ return m.l + (x - xmin) / (xmax - xmin) * (W - m.l - m.r); }
      function Y(p){ return H - m.b - p * (H - m.t - m.b); }
      ctx.strokeStyle = '#333'; ctx.lineWidth = 1;
      drawLine(ctx, m.l, H-m.b, W-m.r, H-m.b); drawLine(ctx, m.l, m.t, m.l, H-m.b);
      ctx.fillStyle = '#333';
      for (let y=0; y<=100; y+=10){ const yy=Y(y/100); ctx.strokeStyle='#eee'; drawLine(ctx,m.l,yy,W-m.r,yy); ctx.fillStyle='#333'; ctx.fillText(String(y), 25, yy+4); }
      ctx.fillText('percent correct (%)', 8, 22);
      const degTicks = [0.5,0.8,1.2,2,3.2,5.1,8.1,12.97,20.75,33.2,53.1,85,90];
      degTicks.forEach(d => { const x=log10(d+1); if (x>=xmin && x<=xmax){ const xx=X(x); ctx.strokeStyle='#ddd'; drawLine(ctx,xx,H-m.b,xx,H-m.b+5); ctx.fillStyle='#333'; ctx.fillText(String(d), xx-8, H-m.b+22); }});
      ctx.fillText('angle difference (deg)', W/2-70, H-18);
      ctx.fillText('log10(angle + 1) is used internally for the fit', W/2-120, H-2);
      selected.forEach((s, idx) => {
        const color = selectedColor(anchor, s.index - 1, DEFAULT_COLORS[idx % DEFAULT_COLORS.length]);
        ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = 2;
        let first = true; ctx.beginPath();
        for (let k=0; k<=220; k++){
          const x = xmin + (xmax-xmin)*k/220;
          const p = weibull(x, s.alpha_log, s.beta);
          const xx = X(x), yy = Y(p);
          if(first){ ctx.moveTo(xx,yy); first=false; } else ctx.lineTo(xx,yy);
        }
        ctx.stroke();
        (s.percent_correct_table || []).forEach(p => {
          const x = log10((p.angle_deg || 0)+1), y=(p.proportion_correct != null ? p.proportion_correct : (p.percent_correct || 0)/100);
          ctx.beginPath(); ctx.arc(X(x), Y(y), Math.max(3, Math.min(9, Math.sqrt(p.n || 1)*1.5)), 0, Math.PI*2); ctx.fill();
        });
        const label = `S${s.index} ${s.timestamp || ''} | acc=${Number(s.accuracy_percent).toFixed(1)}% | thr=${Number(s.threshold_deg).toFixed(1)}°`;
        ctx.fillText(label, m.l+8, m.t + 18 + idx*18);
      });
      if(note) note.textContent = `${selected.length} session(s) selected. Curves are fitted Weibull functions; dots are observed percent-correct by stimulus level.`;
    }
    window.addEventListener('load', () => {
      Object.keys(DASHBOARD_DATA.locations || {}).forEach(loc => {
        const anchor = safeAnchor(loc);
        renderLongitudinal(loc, anchor);
        renderComparison(loc, anchor);
      });
    });
    '''.replace('__PAYLOAD__', payload_json)
    body = (
        '<!doctype html><html lang="en"><head><meta charset="utf-8">'
        '<title>Huxlin FBA Analysis Dashboard</title>'
        f'<style>{css}</style></head><body>'
        '<header><h1>Huxlin FBA Analysis Dashboard</h1><nav>'
        + nav_html
        + '</nav></header><main>'
        + ''.join(sections)
        + f'<script>{js}</script>'
        + '</main></body></html>'
    )
    with open(dashboard_path, "w", encoding="utf-8") as f:
        f.write(body)
    return dashboard_path
def open_dashboard(path):
    try:
        webbrowser.open("file://" + os.path.abspath(path))
    except Exception:
        pass
def main():
    csv_paths = discover_csvs()
    if not csv_paths:
        print("No *_trials.csv files found.")
        return

    out_dir = output_directory_for(csv_paths)
    os.makedirs(out_dir, exist_ok=True)

    session_results = []
    for csv_path in sorted(csv_paths):
        try:
            res = fit_session(csv_path)
        except Exception as e:
            ts = parse_timestamp_from_name(csv_path)
            res = {
                "source_csv": os.path.basename(csv_path),
                "source_csv_abs": os.path.abspath(csv_path),
                "timestamp": ts.strftime("%Y-%m-%d %H:%M:%S") if ts else None,
                "location_id": infer_location_id(csv_path)[0],
                "fit_valid": False,
                "fit_failure_reason": f"analysis_exception: {repr(e)}",
                "n_trials": None,
                "n_unique_levels": None,
                "accuracy_percent": None,
                "percent_correct_table": [],
                "block_accuracy": [],
                "stimulus_class_accuracy": [],
            }
        psych_png, session_json = save_session_plot(res, out_dir)
        stair_png = save_staircase_plot(res, out_dir)
        dist_png = save_distribution_plot(res, out_dir)
        res["psychometric_plot_png"] = os.path.abspath(psych_png)
        res["staircase_plot_png"] = os.path.abspath(stair_png) if stair_png else None
        res["distribution_plot_png"] = os.path.abspath(dist_png) if dist_png else None
        res["session_json_output"] = os.path.abspath(session_json)
        session_results.append(res)

    grouped = defaultdict(list)
    for res in session_results:
        grouped[res["location_id"]].append(res)

    summary_csv = save_summary_csv(session_results, out_dir)

    longitudinal = {
        "source_lineage": "TrainingCodes + DataFitting-compatible per-session fitting; descriptive dashboard additions only; V7 adds fit likelihood metrics, stimulus-level distributions, pooled 3-session thresholds, and variability summaries",
        "constants": {
            "thresholdTarget": THRESHOLD_TARGET,
            "lapse_rate": LAPSE_RATE,
            "chance": CHANCE,
            "within_session_blocks": N_BLOCKS_WITHIN_SESSION,
            "recent_session_window": RECENT_SESSION_WINDOW,
            "pooled_threshold_window": 3,
        },
        "n_sessions_total": len(session_results),
        "summary_csv": os.path.abspath(summary_csv),
        "locations": {},
    }

    for location_id, sessions in grouped.items():
        sessions_sorted = sorted(sessions, key=lambda s: (s.get("timestamp") is None, s.get("timestamp") or ""))
        overlay_png = save_longitudinal_overlay_plot(location_id, sessions_sorted, out_dir)
        block_png = save_block_accuracy_recent_plot(location_id, sessions_sorted, out_dir)
        class_png = save_stimulus_class_plot(location_id, sessions_sorted, out_dir)
        valid_for_stats = [s for s in sessions_sorted if s.get("timestamp") is not None]
        thresholds_for_stats = np.array([s.get("threshold_deg", np.nan) if s.get("fit_valid") else np.nan for s in valid_for_stats], dtype=float)
        acc_for_stats = np.array([s.get("accuracy_percent", np.nan) for s in valid_for_stats], dtype=float)
        pooled_for_stats = pooled_thresholds_by_window(valid_for_stats, window=3) if valid_for_stats else np.array([], dtype=float)
        longitudinal["locations"][location_id] = {
            "n_sessions": len(sessions_sorted),
            "n_valid_fits": sum(1 for s in sessions_sorted if s.get("fit_valid")),
            "variability": {
                "threshold_std_deg": float(np.nanstd(thresholds_for_stats)) if np.isfinite(thresholds_for_stats).any() else None,
                "accuracy_std_percent": float(np.nanstd(acc_for_stats)) if np.isfinite(acc_for_stats).any() else None,
                "pooled_3session_threshold_std_deg": float(np.nanstd(pooled_for_stats)) if np.isfinite(pooled_for_stats).any() else None,
            },
            "pooled_3session_thresholds_deg": [None if not np.isfinite(v) else float(v) for v in pooled_for_stats],
            "accuracy_threshold_overlay_png": os.path.abspath(overlay_png),
            "recent_block_accuracy_png": os.path.abspath(block_png),
            "stimulus_class_accuracy_png": os.path.abspath(class_png),
            "sessions": sessions_sorted,
        }

    long_json = make_writable_output_path(os.path.join(out_dir, "analysis_dashboard_summary.json"))
    with open(long_json, "w", encoding="utf-8") as f:
        json.dump(longitudinal, f, indent=2)

    dashboard_html = generate_html_dashboard(longitudinal, out_dir)
    open_dashboard(dashboard_html)

    print(json.dumps({
        "n_sessions_total": len(session_results),
        "output_directory": os.path.abspath(out_dir),
        "dashboard_html": os.path.abspath(dashboard_html),
        "dashboard_json": os.path.abspath(long_json),
        "summary_csv": os.path.abspath(summary_csv),
        "locations": {k: {"n_sessions": v["n_sessions"], "n_valid_fits": v["n_valid_fits"]}
                      for k, v in longitudinal["locations"].items()}
    }, indent=2))


if __name__ == "__main__":
    main()
