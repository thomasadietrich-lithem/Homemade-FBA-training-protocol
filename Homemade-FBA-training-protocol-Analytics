def _relpath_for_html(path, base_dir):
    if path is None:
        return None
    try:
        return os.path.relpath(path, base_dir).replace(os.sep, "/")
    except Exception:
        return str(path).replace(os.sep, "/")


def _safe_anchor(text):
    return re.sub(r'[^A-Za-z0-9_-]+', '_', str(text or 'section'))


