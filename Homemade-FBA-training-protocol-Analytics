def save_stimulus_class_plot(location_id, sessions, out_dir):
    valid = [s for s in sessions if s.get("timestamp") is not None]
    valid = sorted(valid, key=lambda s: s["timestamp"])
    out_png = make_writable_output_path(os.path.join(out_dir, f"longitudinal_{location_id}_stimulus_class_accuracy.png"))

    # Collect all classes observed.
    all_classes = []
    for s in valid:
        for row in s.get("stimulus_class_accuracy", []):
            cls = row.get("stimulus_class", "unknown")
            if cls not in all_classes:
                all_classes.append(cls)
    preferred = [c for c in ["UP", "DOWN", "LEFT", "RIGHT", "tilt +", "tilt -", "unknown"] if c in all_classes]
    classes = preferred if preferred else all_classes

    fig, ax = plt.subplots(figsize=(13, 5))
    if valid and classes:
        x = np.arange(1, len(valid) + 1)
        dates = [datetime.strptime(s["timestamp"], "%Y-%m-%d %H:%M:%S").strftime("%m-%d\n%H:%M") for s in valid]
        for cls in classes:
            vals = []
            for s in valid:
                found = np.nan
                for row in s.get("stimulus_class_accuracy", []):
                    if row.get("stimulus_class") == cls:
                        found = row.get("accuracy_percent", np.nan)
                        break
                vals.append(found)
            ax.plot(x, vals, marker="o", linewidth=1.2, label=cls)
        ax.set_xticks(x)
        ax.set_xticklabels(dates, rotation=45, ha="right", fontsize=8)
        ax.legend(fontsize=8, loc="best")
    ax.set_xlabel("session")
    ax.set_ylabel("accuracy (%)")
    ax.set_ylim(0, 100)
    ax.set_yticks(np.arange(0, 101, 10))
    ax.set_title(f"Stimulus-class raw accuracy - {location_id}")
    fig.tight_layout()
    fig.savefig(out_png, dpi=150)
