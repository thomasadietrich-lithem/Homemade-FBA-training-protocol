def _fit_threshold_from_dataframe(dd):
    """Fit a threshold from an already-cleaned concatenated trial dataframe."""
    if len(dd) < MIN_TRIALS_FOR_SESSION_FIT or dd["angle_dev_deg"].nunique() < MIN_UNIQUE_LEVELS_FOR_SESSION_FIT:
        return np.nan
    x_log = np.log10(dd["angle_dev_deg"].to_numpy(dtype=float) + 1.0)
    y_bin = dd["correct"].to_numpy(dtype=float)
    xmin = max(1e-6, float(np.min(x_log))); xmax = max(xmin + 1e-6, float(np.max(x_log)))
    starts = [(np.median(x_log), 2.0), (xmax * 0.75, 2.0), (xmax * 0.90, 3.0), (max(xmin, xmax * 0.50), 1.5)]
    best = None
    for a0, b0 in starts:
        try:
            res = minimize(neg_log_likelihood, x0=np.array([a0, b0], dtype=float), args=(x_log, y_bin), method="L-BFGS-B", bounds=[(xmin, xmax), (0.25, 12.0)])
            if best is None or res.fun < best.fun:
                best = res
        except Exception:
            continue
    if best is None or not np.isfinite(best.fun):
        return np.nan
    thr_deg, _ = threshold_from_params(float(best.x[0]), float(best.x[1]))
    observed_max = float(np.max(dd["angle_dev_deg"]))
    if not np.isfinite(thr_deg) or thr_deg < 0 or thr_deg > max(observed_max * 1.5, observed_max + 5):
        return np.nan
    return float(thr_deg)


def pooled_thresholds_by_window(sessions, window=3):
    """Return rolling pooled Weibull thresholds over the previous `window` sessions."""
    ordered = sorted([s for s in sessions if s.get("timestamp") is not None], key=lambda s: s["timestamp"])
    pooled = []
    for i in range(len(ordered)):
        subset = ordered[max(0, i - window + 1): i + 1]
        dfs = []
        for s in subset:
            try:
                dfs.append(clean_trial_frame(s["source_csv_abs"]))
            except Exception:
                pass
        pooled.append(np.nan if not dfs else _fit_threshold_from_dataframe(pd.concat(dfs, ignore_index=True)))
    return np.array(pooled, dtype=float)


def rolling_mean(values, window=3):
    s = pd.Series(values, dtype=float)
    return s.rolling(window=window, min_periods=1).mean().to_numpy()


def save_longitudinal_overlay_plot(location_id, sessions, out_dir):
    valid = [s for s in sessions if s.get("timestamp") is not None]
    valid = sorted(valid, key=lambda s: s["timestamp"])
    out_png = make_writable_output_path(os.path.join(out_dir, f"longitudinal_{location_id}_accuracy_threshold_overlay.png"))

    fig, ax_thr = plt.subplots(figsize=(13, 6))
    if valid:
        x = np.arange(1, len(valid) + 1)
        dates = [datetime.strptime(s["timestamp"], "%Y-%m-%d %H:%M:%S").strftime("%m-%d\n%H:%M") for s in valid]
        thresholds = np.array([s["threshold_deg"] if s.get("fit_valid") else np.nan for s in valid], dtype=float)
        acc = np.array([s.get("accuracy_percent", np.nan) for s in valid], dtype=float)
        ntr = [s.get("n_trials") for s in valid]

        ax_thr.plot(x, thresholds, marker="o", linewidth=1.4, label="Weibull threshold (deg)")
        ax_thr.plot(x, rolling_mean(thresholds, 3), linestyle="--", linewidth=1.4, label="3-session mean threshold")
        pooled_thr = pooled_thresholds_by_window(valid, window=3)
        ax_thr.plot(x, pooled_thr, linestyle=":", linewidth=2.0, label="3-session pooled Weibull threshold")
        ax_thr.set_ylabel("threshold (deg; lower is better)")
        ax_thr.set_xlabel("session")
        ax_thr.set_xticks(x)
        ax_thr.set_xticklabels(dates, rotation=45, ha="right", fontsize=8)
        for xi, yi, nt in zip(x, thresholds, ntr):
            if np.isfinite(yi):
                ax_thr.annotate(f"n={nt}", (xi, yi), textcoords="offset points", xytext=(0, 6), ha="center", fontsize=7)

        ax_acc = ax_thr.twinx()
        ax_acc.plot(x, acc, marker="s", linewidth=1.2, label="raw accuracy (%)")
        ax_acc.plot(x, rolling_mean(acc, 3), linestyle=":", linewidth=1.6, label="3-session mean accuracy")
        ax_acc.set_ylabel("accuracy (%; higher is better)")
        ax_acc.set_ylim(0, 100)
        ax_acc.set_yticks(np.arange(0, 101, 10))

        lines, labels = ax_thr.get_legend_handles_labels()
        lines2, labels2 = ax_acc.get_legend_handles_labels()
        ax_thr.legend(lines + lines2, labels + labels2, loc="best", fontsize=8)
    ax_thr.set_title(f"FDD longitudinal dashboard - {location_id} (n={len(valid)} sessions)")
    fig.tight_layout()
    fig.savefig(out_png, dpi=150)
    plt.close(fig)
    return out_png


def save_block_accuracy_recent_plot(location_id, sessions, out_dir):
    valid = [s for s in sessions if s.get("timestamp") is not None]
    valid = sorted(valid, key=lambda s: s["timestamp"])[-RECENT_SESSION_WINDOW:]
    out_png = make_writable_output_path(os.path.join(out_dir, f"recent_{location_id}_within_session_block_accuracy.png"))

    fig, ax = plt.subplots(figsize=(9, 5))
    block_matrix = []
    labels = []
    for s in valid:
        blocks = s.get("block_accuracy", [])
        vals = np.full(N_BLOCKS_WITHIN_SESSION, np.nan)
        for b in blocks:
            idx = int(b["block"]) - 1
            if 0 <= idx < N_BLOCKS_WITHIN_SESSION:
                vals[idx] = b["accuracy_percent"]
        block_matrix.append(vals)
        labels.append(datetime.strptime(s["timestamp"], "%Y-%m-%d %H:%M:%S").strftime("%m-%d %H:%M"))
