# ============================================================
# Huxlin-style standalone dashboard for FBA / TiltGlobal home-training CSV files
# ============================================================
#
# Scope:
# - descriptive analysis only; no automatic clinical decision rule
# - one psychometric Weibull fit per session
# - one longitudinal dashboard per trained location
# - one within-session block performance dashboard per trained location
# - one stimulus-direction comparison dashboard per trained location
#
# Core lineage retained from the previous analyser:
# - fine-task fit is performed in log10(angle_deg + 1)
# - chance = 0.5
# - lapse = 0.05
# - threshold target = 0.725
#
# Additional descriptive views requested:
# - raw accuracy and threshold overlay over sessions
# - within-session accuracy split into equal trial blocks, plotted for recent sessions
# - stimulus class comparison: UP vs DOWN for angle_set=0, LEFT vs RIGHT for angle_set=1
# - V7 additions: fit likelihood metrics, stimulus-level distribution,
#   3-session pooled thresholds, and variability summaries
#
# Output folder:
# - analysis_results/ next to the data folder whenever CSV files live in ./data
#

CHANCE = 0.5
LAPSE_RATE = 0.05
THRESHOLD_TARGET = 0.725

MIN_TRIALS_FOR_SESSION_FIT = 80
MIN_UNIQUE_LEVELS_FOR_SESSION_FIT = 4
N_BLOCKS_WITHIN_SESSION = 6
RECENT_SESSION_WINDOW = 5


def make_writable_output_path(path):
    base, ext = os.path.splitext(path)
    candidate = path
    idx = 1
    while True:
        try:
            parent = os.path.dirname(candidate)
            os.makedirs(parent, exist_ok=True)
            with open(candidate, "ab"):
                pass
            return candidate
        except Exception:
            candidate = f"{base}_{idx}{ext}"
            idx += 1


def weibull_logspace(x_log, alpha_log, beta):
    xx = np.maximum(x_log, 1e-9)
    aa = max(alpha_log, 1e-9)
    return CHANCE + (1.0 - CHANCE - LAPSE_RATE) * (1.0 - np.exp(- (xx / aa) ** beta))


def neg_log_likelihood(params, x_log, y_bin):
    alpha_log, beta = params
    p = np.clip(weibull_logspace(x_log, alpha_log, beta), 1e-6, 1.0 - 1e-6)
    return -np.sum(y_bin * np.log(p) + (1 - y_bin) * np.log(1 - p))


def bernoulli_log_likelihood_from_prob(y_bin, p):
    p = np.clip(np.asarray(p, dtype=float), 1e-6, 1.0 - 1e-6)
    y = np.asarray(y_bin, dtype=float)
    return float(np.sum(y * np.log(p) + (1.0 - y) * np.log(1.0 - p)))


def fit_quality_metrics(x_log, y_bin, alpha_log, beta):
    """Return descriptive likelihood metrics for the fitted Weibull.

    These are fit-quality aids only. They do not change the fitted threshold and
    they are not used for automatic decision-making.
    """
    model_p = weibull_logspace(x_log, alpha_log, beta)
    ll_model = bernoulli_log_likelihood_from_prob(y_bin, model_p)
    empirical_p = float(np.mean(y_bin)) if len(y_bin) else CHANCE
    empirical_p = float(np.clip(empirical_p, 1e-6, 1.0 - 1e-6))
    null_p = np.full_like(y_bin, empirical_p, dtype=float)
    ll_null = bernoulli_log_likelihood_from_prob(y_bin, null_p)
    pseudo_r2 = None
    if ll_null != 0 and np.isfinite(ll_null):
        pseudo_r2 = 1.0 - (ll_model / ll_null)
    n = int(len(y_bin)); k = 2
    return {
        "fit_log_likelihood": float(ll_model),
        "null_log_likelihood": float(ll_null),
        "fit_pseudo_r2": float(pseudo_r2) if pseudo_r2 is not None and np.isfinite(pseudo_r2) else None,
        "fit_aic": float(2 * k - 2 * ll_model),
        "fit_bic": float(k * np.log(max(n, 1)) - 2 * ll_model),
    }


def threshold_from_params(alpha_log, beta):
    scaled = (THRESHOLD_TARGET - CHANCE) / (1.0 - CHANCE - LAPSE_RATE)
    scaled = np.clip(scaled, 1e-9, 1.0 - 1e-9)
    x_thr_log = alpha_log * ((-np.log(1.0 - scaled)) ** (1.0 / beta))
    thr_deg = (10.0 ** x_thr_log) - 1.0
    return max(0.0, float(thr_deg)), float(x_thr_log)


def parse_timestamp_from_name(path):
    name = os.path.basename(path)
    m = re.search(r'_(\d{8}_\d{6})_(?:trials|summary)\.', name)
    if not m:
        return None
    try:
        return datetime.strptime(m.group(1), "%Y%m%d_%H%M%S")
    except Exception:
        return None


def companion_summary_path(csv_path):
    return csv_path.replace("_trials.csv", "_summary.json")


def load_companion_summary(csv_path):
    p = companion_summary_path(csv_path)
    if not os.path.isfile(p):
        return None
    try:
        with open(p, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def infer_location_id(csv_path):
    meta = load_companion_summary(csv_path)
    if meta:
        try:
            loc = meta.get("location_deg_internal", {})
            h = float(loc.get("H"))
            v = float(loc.get("V_internal"))
            return f"H{h:+.2f}_V{v:+.2f}", meta
        except Exception:
            pass
    return "unknown_location", meta


def output_directory_for(csv_paths):
    first_dir = os.path.dirname(os.path.abspath(csv_paths[0]))
    parent = os.path.dirname(first_dir) if os.path.basename(first_dir).lower() == "data" else first_dir
    candidate = os.path.join(parent, "analysis_results")
    try:
        os.makedirs(candidate, exist_ok=True)
        testfile = os.path.join(candidate, ".write_test")
        with open(testfile, "w", encoding="utf-8") as f:
            f.write("ok")
        os.remove(testfile)
        return candidate
    except Exception:
        fallback = os.path.join(first_dir, "analysis_results")
        os.makedirs(fallback, exist_ok=True)
        return fallback


def discover_csvs():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    cwd = os.getcwd()
    patterns = [
        os.path.join(cwd, "data", "*_trials.csv"),
        os.path.join(script_dir, "data", "*_trials.csv"),
        os.path.join(script_dir, "*_trials.csv"),
    ]
    for patt in patterns:
        found = sorted(glob.glob(patt))
        if found:
            return found
    return []


def clean_trial_frame(csv_path):
    df = pd.read_csv(csv_path)
    required = {"angle_dev_deg", "correct"}
    missing = sorted(required - set(df.columns))
    if missing:
        raise ValueError(f"Missing required columns {missing} in {os.path.basename(csv_path)}")

    # Preserve optional columns if present.
    keep = [c for c in ["trial", "angle_dev_deg", "staircase", "direction_code", "orientation_sign", "rt_s", "correct", "angle_deg"] if c in df.columns]
    dd = df[keep].copy()
    dd = dd.replace([np.inf, -np.inf], np.nan)
    dd["angle_dev_deg"] = pd.to_numeric(dd["angle_dev_deg"], errors="coerce")

    # Strict but tolerant correctness normalization.
    if dd["correct"].dtype == bool:
        dd["correct"] = dd["correct"].astype(int)
    else:
        dd["correct"] = dd["correct"].replace({
            True: 1, False: 0,
            "True": 1, "False": 0, "true": 1, "false": 0,
            "TRUE": 1, "FALSE": 0,
            "correct": 1, "incorrect": 0,
            "Correct": 1, "Incorrect": 0,
        })
        dd["correct"] = pd.to_numeric(dd["correct"], errors="coerce")
    if "trial" in dd.columns:
        dd["trial"] = pd.to_numeric(dd["trial"], errors="coerce")
    if "angle_deg" in dd.columns:
        dd["angle_deg"] = pd.to_numeric(dd["angle_deg"], errors="coerce")
    if "direction_code" in dd.columns:
        dd["direction_code"] = pd.to_numeric(dd["direction_code"], errors="coerce")
    if "orientation_sign" in dd.columns:
        dd["orientation_sign"] = pd.to_numeric(dd["orientation_sign"], errors="coerce")

    dd = dd.dropna(subset=["angle_dev_deg", "correct"])
    dd = dd[(dd["angle_dev_deg"] >= 0) & (dd["correct"].isin([0, 1]))].copy()
    dd["correct"] = dd["correct"].astype(float)
    if len(dd) == 0:
        raise ValueError(f"No valid trial rows after cleaning {os.path.basename(csv_path)}")
    if "trial" in dd.columns:
        dd = dd.sort_values("trial")
    else:
        dd = dd.reset_index(drop=True)
        dd["trial"] = np.arange(1, len(dd) + 1)
    return dd


def stimulus_class_from_trials(dd, angle_set):
    """Return class labels for each trial: UP/DOWN or LEFT/RIGHT when possible."""
    labels = pd.Series(["unknown"] * len(dd), index=dd.index, dtype="object")
    if "angle_deg" in dd.columns and dd["angle_deg"].notna().any():
        ang = np.deg2rad(dd["angle_deg"].astype(float).to_numpy())
        if angle_set == 0:
            labels[:] = np.where(np.sin(ang) > 0, "UP", "DOWN")
        elif angle_set == 1:
            labels[:] = np.where(np.cos(ang) < 0, "LEFT", "RIGHT")
        else:
            labels[:] = "unknown"
    elif "orientation_sign" in dd.columns:
        # Fallback only: sign is not always equivalent across base directions, but it is better than dropping the view.
        if angle_set == 0:
            labels[:] = np.where(dd["orientation_sign"].astype(float) > 0, "tilt +", "tilt -")
        elif angle_set == 1:
            labels[:] = np.where(dd["orientation_sign"].astype(float) > 0, "tilt +", "tilt -")
    return labels


def fit_session(csv_path):
    dd = clean_trial_frame(csv_path)
    timestamp = parse_timestamp_from_name(csv_path)
    location_id, meta = infer_location_id(csv_path)

    result = {
        "source_csv": os.path.basename(csv_path),
        "source_csv_abs": os.path.abspath(csv_path),
        "timestamp": timestamp.strftime("%Y-%m-%d %H:%M:%S") if timestamp else None,
        "location_id": location_id,
        "n_trials": int(len(dd)),
        "n_unique_levels": int(dd["angle_dev_deg"].nunique()),
        "accuracy_percent": float(dd["correct"].mean() * 100.0) if len(dd) else None,
        "fit_valid": False,
        "fit_failure_reason": None,
        "threshold_deg": None,
        "threshold_log10_plus1": None,
        "alpha_log": None,
        "beta": None,
        "fit_log_likelihood": None,
        "null_log_likelihood": None,
        "fit_pseudo_r2": None,
        "fit_aic": None,
        "fit_bic": None,
        "percent_correct_easiest": None,
        "percent_correct_table": [],
        "coarse_session_staircase_estimate_deg": None,
        "block_accuracy": [],
        "stimulus_class_accuracy": [],
    }

    angle_set = None
    if meta is not None:
        result["companion_summary"] = os.path.basename(companion_summary_path(csv_path))
        result["coarse_session_staircase_estimate_deg"] = meta.get("coarse_session_staircase_estimate_deg") or meta.get("final_threshold_deg")
        result["location_deg_internal"] = meta.get("location_deg_internal")
        result["angle_set"] = meta.get("angle_set")
        angle_set = meta.get("angle_set")
        result["fixed_protocol"] = meta.get("fixed_protocol")
        result["training_lineage"] = meta.get("source_lineage")
    if angle_set is None:
        angle_set = 0
        result["angle_set"] = angle_set
    try:
        angle_set = int(angle_set)
    except Exception:
        angle_set = 0

    grouped = dd.groupby("angle_dev_deg")["correct"].agg(["mean", "count"]).reset_index().sort_values("angle_dev_deg")
    for _, row in grouped.iterrows():
        result["percent_correct_table"].append({
            "angle_deg": float(row["angle_dev_deg"]),
            "angle_plus1_deg": float(row["angle_dev_deg"] + 1.0),
            "n": int(row["count"]),
            "percent_correct": float(row["mean"] * 100.0),
            "proportion_correct": float(row["mean"]),
        })

    if len(grouped) > 0:
        result["percent_correct_easiest"] = float(grouped.iloc[-1]["mean"] * 100.0)

    # Within-session block accuracy: descriptive only.
    if len(dd) > 0:
        block_ids = np.floor(np.linspace(0, N_BLOCKS_WITHIN_SESSION, len(dd), endpoint=False)).astype(int) + 1
        block_ids = np.clip(block_ids, 1, N_BLOCKS_WITHIN_SESSION)
        dd_blocks = dd.copy()
        dd_blocks["block"] = block_ids
        btab = dd_blocks.groupby("block")["correct"].agg(["mean", "count"]).reset_index()
        for _, row in btab.iterrows():
            result["block_accuracy"].append({
                "block": int(row["block"]),
                "n": int(row["count"]),
                "accuracy_percent": float(row["mean"] * 100.0),
            })

        labels = stimulus_class_from_trials(dd, angle_set)
        dd_cls = dd.copy()
        dd_cls["stimulus_class"] = labels
        ctab = dd_cls.groupby("stimulus_class")["correct"].agg(["mean", "count"]).reset_index()
        for _, row in ctab.iterrows():
            result["stimulus_class_accuracy"].append({
                "stimulus_class": str(row["stimulus_class"]),
                "n": int(row["count"]),
                "accuracy_percent": float(row["mean"] * 100.0),
            })

    if result["n_trials"] < MIN_TRIALS_FOR_SESSION_FIT:
        result["fit_failure_reason"] = f"too_few_trials (<{MIN_TRIALS_FOR_SESSION_FIT})"
        return result
    if result["n_unique_levels"] < MIN_UNIQUE_LEVELS_FOR_SESSION_FIT:
        result["fit_failure_reason"] = f"too_few_unique_levels (<{MIN_UNIQUE_LEVELS_FOR_SESSION_FIT})"
        return result

    x_log = np.log10(dd["angle_dev_deg"].to_numpy(dtype=float) + 1.0)
    y_bin = dd["correct"].to_numpy(dtype=float)

    xmin = max(1e-6, float(np.min(x_log)))
    xmax = max(xmin + 1e-6, float(np.max(x_log)))
    starts = [
        (np.median(x_log), 2.0),
        (xmax * 0.75, 2.0),
        (xmax * 0.90, 3.0),
        (max(xmin, xmax * 0.50), 1.5),
    ]

    best = None
    for a0, b0 in starts:
        try:
            res = minimize(
                neg_log_likelihood,
                x0=np.array([a0, b0], dtype=float),
                args=(x_log, y_bin),
                method="L-BFGS-B",
                bounds=[(xmin, xmax), (0.25, 12.0)],
            )
            if best is None or res.fun < best.fun:
                best = res
        except Exception:
            continue

    if best is None or not np.isfinite(best.fun):
        result["fit_failure_reason"] = "optimizer_failed"
        return result

    alpha_log = float(best.x[0])
    beta = float(best.x[1])
    thr_deg, thr_log = threshold_from_params(alpha_log, beta)

    observed_max = float(np.max(dd["angle_dev_deg"]))
    if not np.isfinite(thr_deg):
        result["fit_failure_reason"] = "non_finite_threshold"
        return result
    if thr_deg < 0 or thr_deg > max(observed_max * 1.5, observed_max + 5):
        result["fit_failure_reason"] = "threshold_outside_reasonable_session_range"
        return result

    result["fit_valid"] = True
    result["threshold_deg"] = float(thr_deg)
    result["threshold_log10_plus1"] = float(thr_log)
    result["alpha_log"] = alpha_log
    result["beta"] = beta
    result.update(fit_quality_metrics(x_log, y_bin, alpha_log, beta))
    return result


def add_percent_axis_formatting():
    y_ticks = np.arange(0.0, 101.0, 10.0)
    plt.yticks(y_ticks, [f"{int(v)}" for v in y_ticks])
    plt.ylim(0.0, 102.0)


def add_secondary_degree_axis(ax):
    def forward_log_to_deg(x):
        return (10.0 ** np.asarray(x)) - 1.0
    def inverse_deg_to_log(x):
        x = np.asarray(x)
        return np.log10(np.maximum(x, 0.0) + 1.0)
    secax = ax.secondary_xaxis('top', functions=(forward_log_to_deg, inverse_deg_to_log))
    secax.set_xlabel("angle difference (deg)")
    deg_ticks = [0.5, 0.8, 1.2, 2, 3.2, 5.1, 8.1, 12.97, 20.75, 33.2, 53.1, 85, 90]
    xlo, xhi = ax.get_xlim()
    allowed = [d for d in deg_ticks if xlo <= np.log10(d + 1.0) <= xhi]
    if allowed:
        secax.set_xticks(allowed)
        secax.set_xticklabels([f"{d:g}" for d in allowed])
    return secax


def save_session_plot(session_result, out_dir):
    csv_path = session_result["source_csv_abs"]
    out_base = os.path.splitext(os.path.basename(csv_path))[0].replace("_trials", "")
    out_png = make_writable_output_path(os.path.join(out_dir, f"{out_base}_psychometric_weibull.png"))
    out_json = make_writable_output_path(os.path.join(out_dir, f"{out_base}_session_summary.json"))

    with open(out_json, "w", encoding="utf-8") as f:
        json.dump(session_result, f, indent=2)

    fig, ax = plt.subplots(figsize=(7, 5))
    tbl = session_result.get("percent_correct_table", [])
    if tbl:
        xs = np.array([r["angle_plus1_deg"] for r in tbl], dtype=float)
        ys = np.array([r["percent_correct"] for r in tbl], dtype=float)
        ns = np.array([r["n"] for r in tbl], dtype=int)
        xlog = np.log10(xs)
        ax.scatter(xlog, ys, s=np.clip(ns * 8, 30, 220), alpha=0.9)
        for x, y, n in zip(xlog, ys, ns):
            ax.annotate(f"n={n}", (x, y), textcoords="offset points", xytext=(0, 6), ha="center", fontsize=8)
        if session_result["fit_valid"]:
            grid_deg = np.linspace(max(0, min(xs) - 1.0), max(xs) - 1.0, 300)
            grid_log = np.log10(grid_deg + 1.0)
            curve = weibull_logspace(grid_log, session_result["alpha_log"], session_result["beta"]) * 100.0
            ax.plot(grid_log, curve, linewidth=2)
            thr_deg = session_result["threshold_deg"]
            thr_log = np.log10(thr_deg + 1.0)
            ax.axvline(thr_log, linestyle="--", linewidth=1)
            ax.annotate(f"thr={thr_deg:.2f}°", (thr_log, THRESHOLD_TARGET * 100.0),
                        textcoords="offset points", xytext=(6, 6), fontsize=9)
        title = f"{session_result['source_csv']} | {session_result['location_id']}\ntrials={session_result['n_trials']} | levels={session_result['n_unique_levels']}"
    else:
        title = f"{session_result['source_csv']} | no usable data"
    ax.set_xlabel("log10(angle + 1)")
    ax.set_ylabel("percent correct (%)")
    ax.set_ylim(0, 102)
    ax.set_yticks(np.arange(0, 101, 10))
    add_secondary_degree_axis(ax)
    ax.set_title(title, fontsize=10)
    fig.tight_layout()
    fig.savefig(out_png, dpi=150)
    plt.close(fig)
    return out_png, out_json


